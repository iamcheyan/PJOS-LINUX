{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pjos.local/schema/caps-1.json",
  "title": "PJOS Capability Set",
  "description": "Generated at build time from board.json + soc.json. See docs/bsp-v2/04-capability.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "board", "soc", "caps"],
  "properties": {
    "schema": { "const": "pjos.caps/1" },
    "board": { "type": "string" },
    "soc": { "type": "string" },
    "verified": { "type": "boolean" },
    "generated_from": { "type": "string" },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wifi", "bluetooth", "touch", "vibration", "hdmi", "gpu",
        "rtc", "usb_gadget", "usb_host", "brightness", "audio"
      ],
      "properties": {
        "wifi": { "enum": ["yes", "no", "unknown"] },
        "bluetooth": { "enum": ["yes", "no", "unknown"] },
        "touch": { "enum": ["yes", "no", "unknown"] },
        "vibration": { "enum": ["yes", "no", "unknown"] },
        "hdmi": { "enum": ["yes", "no", "unknown"] },
        "gpu": { "enum": ["yes", "no", "unknown"] },
        "rtc": { "enum": ["yes", "no", "unknown"] },
        "usb_gadget": { "enum": ["yes", "no", "unknown"] },
        "usb_host": { "enum": ["yes", "no", "unknown"] },
        "brightness": { "enum": ["yes", "no", "unknown"] },
        "audio": { "enum": ["yes", "no", "unknown"] }
      }
    }
  }
}
