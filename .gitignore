/overlay/usr/share/pocketshell/System/compat/install/
/overlay/usr/share/pocketshell/System/pocketjs/apps/*.gba
/overlay/usr/share/pocketshell/System/pocketjs/apps/kanade.pocket
/overlay/usr/share/pocketshell/System/pocketjs/bin/launcher/
