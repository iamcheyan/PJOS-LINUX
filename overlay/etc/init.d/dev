#!/bin/sh
# Development conveniences (SSH, SFTP, ADB), started by rcS in the background.
# This file is only installed in dev-flavour images (build-rootfs.sh).

# Persistent dropbear host keys on /data.
mkdir -p /data/dropbear
for t in rsa ed25519; do
	k=/data/dropbear/dropbear_${t}_host_key
	[ -f "$k" ] || dropbearkey -t "$t" -f "$k" >/dev/null 2>&1
done

# SSH daemon (root password from baseos.conf; default root — dev images only).
dropbear -r /data/dropbear/dropbear_rsa_host_key \
         -r /data/dropbear/dropbear_ed25519_host_key -B 2>/dev/null

# adb-over-USB gadget. Initial setup is bounded and backgrounded. Once it has
# completed, the kernel's /sbin/hotplug handler may recover a later device-role
# attach; it never forces the shared port out of host role or changes storage.
if [ -x /usr/sbin/usb-gadget-adb ]; then
    (
        /usr/sbin/usb-gadget-adb setup
        : > /run/usb-adb-hotplug-ready
    ) &
fi
