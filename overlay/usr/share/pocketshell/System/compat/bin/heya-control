#!/bin/sh
# BaseOS replacement for the ROCKNIX heya-control used by the settings bridge.
# Wi-Fi is only changed through an existing wpa_supplicant control socket;
# Bluetooth is reported unsupported when bluetoothctl cannot talk to D-Bus.
set -u
volume_state=${BASEOS_VOLUME_STATE:-/run/baseos-volume.percent}
[ -d /run ] || volume_state=/tmp/baseos-volume.percent
persistent_state=${BASEOS_VOLUME_PERSISTENT:-/storage/.config/baseos/volume.percent}
event_state=${BASEOS_VOLUME_EVENT:-/run/baseos-volume.sequence}
[ -d /run ] || event_state=/tmp/baseos-volume.sequence
case "${1-}" in
    volume-state)
        value=$(cat "$volume_state" 2>/dev/null || :)
        case "$value" in
            ''|*[!0-9]*)
                value=$(cat "$persistent_state" 2>/dev/null || :)
                ;;
        esac
        case "$value" in
            ''|*[!0-9]*) ;;
            *) if [ "$value" -le 100 ] 2>/dev/null; then echo "$value"; exit 0; fi ;;
        esac
        mixer=$(command -v amixer 2>/dev/null || echo /bin/amixer)
        value=$("$mixer" -c 0 sget 'digital volume' 2>/dev/null |
            sed -n 's/.*\[\([0-9]*\)%\].*/\1/p' | head -1)
        case "$value" in ''|*[!0-9]*) exit 1 ;; esac
        [ "$value" -le 100 ] || exit 1
        echo "$value"
        ;;
    volume)
        value=${2-}
        case "$value" in ''|*[!0-9]*) exit 2 ;; esac
        [ "$value" -le 100 ] || exit 2
        mixer=$(command -v amixer 2>/dev/null || echo /bin/amixer)
        # The codec's DAC gain alone did not change the speaker loudness on this
        # panel; lineout is the analog stage that does. Drive both from the same
        # percentage so the UI, the wheel and the tick all agree.
        #
        # Write raw register values. The codec also temporarily sets digital
        # gain to its maximum during PCM power transitions, including the tick
        # below. Publish the user's setting separately after successful writes;
        # UI polling and the wheel must use volume-state, not that ramp register.
        digital=$(( (value * 63 + 50) / 100 ))
        lineout=$(( (value * 31 + 50) / 100 ))
        "$mixer" -q -c 0 cset numid=3 "$lineout" >/dev/null 2>&1 \
            || "$mixer" -q -c 0 set "lineout volume" "${value}%" >/dev/null 2>&1 || :
        "$mixer" -q -c 0 cset numid=2 "$digital" >/dev/null 2>&1 \
            || "$mixer" -q -c 0 set "digital volume" "${value}%" >/dev/null 2>&1 || :
        # Zero really means silent: the amp stays enabled at 0% on this codec, so
        # close the speaker switch as well and reopen it on the next step.
        if [ "$value" -eq 0 ]; then
            "$mixer" -q -c 0 sset 'SPK' off >/dev/null 2>&1 || :
        else
            "$mixer" -q -c 0 sset 'SPK' on >/dev/null 2>&1 || :
        fi
        # Atomic publication prevents readers seeing a truncated/empty value.
        printf '%s\n' "$value" > "$volume_state.$$" &&
            mv -f "$volume_state.$$" "$volume_state" || {
                rm -f "$volume_state.$$"
                exit 1
            }
        mkdir -p "${persistent_state%/*}" 2>/dev/null || :
        printf '%s\n' "$value" > "$persistent_state.$$" &&
            mv -f "$persistent_state.$$" "$persistent_state" 2>/dev/null || rm -f "$persistent_state.$$"
        event_state=${BASEOS_VOLUME_EVENT:-/run/baseos-volume.sequence}
        sequence=$(cat "$event_state" 2>/dev/null || :)
        case "$sequence" in ''|*[!0-9]*) sequence=0 ;; esac
        sequence=$((sequence + 1))
        if printf '%s\n' "$sequence" > "$event_state.$$"; then
            mv -f "$event_state.$$" "$event_state" 2>/dev/null || rm -f "$event_state.$$"
        fi
        # Play feedback tick unless suppressed (e.g. boot restoration)
        if [ "${3-}" != "--no-beep" ] && [ "${3-}" != "-q" ]; then
            for beep in /storage/System/compat/share/audio/beep.wav \
                        /usr/share/pocketshell/System/compat/share/audio/beep.wav; do
                [ -f "$beep" ] || continue
                command -v aplay >/dev/null 2>&1 && aplay -q "$beep" >/dev/null 2>&1
                break
            done
        fi
        exit 0
        ;;
    restore)
        value=$(cat "$persistent_state" 2>/dev/null || :)
        case "$value" in
            ''|*[!0-9]*) exit 0 ;;
        esac
        [ "$value" -le 100 ] || exit 0
        exec "$0" volume "$value" --no-beep
        ;;
    brightness-state)
        if [ -f /sys/class/led/tg5040_exterme_brightness ]; then
            val=$(cat /sys/class/led/tg5040_exterme_brightness 2>/dev/null || :)
            case "$val" in
                ''|*[!0-9]*) echo 60 ;;
                *) echo "$val" ;;
            esac
            exit 0
        fi
        if [ -f /sys/devices/virtual/disp/disp/attr/enhance_bright ]; then
            val=$(awk '{print $1}' /sys/devices/virtual/disp/disp/attr/enhance_bright 2>/dev/null || :)
            case "$val" in
                ''|*[!0-9]*) echo 50 ;;
                *) echo "$val" ;;
            esac
            exit 0
        fi
        exit 1
        ;;
    brightness)
        value=${2-}
        case "$value" in ''|*[!0-9]*) exit 2 ;; esac
        [ "$value" -le 100 ] || exit 2
        if [ -w /sys/class/led/tg5040_exterme_brightness ]; then
            echo "$value" > /sys/class/led/tg5040_exterme_brightness 2>/dev/null
            [ -w /sys/devices/virtual/disp/disp/attr/enhance_bright ] && echo "$value" > /sys/devices/virtual/disp/disp/attr/enhance_bright 2>/dev/null || :
            exit 0
        fi
        # enhance_bright is not the backlight: baseos-panel drives dispdbg and
        # verifies the driver's read-back. Floor at the same 10 the helper uses.
        panel=/mnt/sdcard/System/bin/baseos-panel
        [ -x "$panel" ] || panel=/usr/sbin/baseos-panel
        [ -x "$panel" ] || exit 1
        level=$(( (value * 255 + 50) / 100 ))
        [ "$level" -ge 10 ] || level=10
        exec "$panel" level "$level"
        ;;
    wifi)
        state=${2-}
        case "$state" in on|off) ;; *) exit 2 ;; esac
        for iface in wlan0 wlan1; do
            if wpa_cli -i "$iface" ping >/dev/null 2>&1; then
                case "$state" in
                    on) wpa_cli -i "$iface" reconnect >/dev/null 2>&1 ;;
                    off) wpa_cli -i "$iface" disconnect >/dev/null 2>&1 ;;
                esac
                exit $?
            fi
        done
        echo "wi-fi control socket unavailable" >&2
        exit 1
        ;;
    bluetooth)
        state=${2-}
        case "$state" in on|off) ;; *) exit 2 ;; esac
        command -v bluetoothctl >/dev/null 2>&1 || exit 1
        bluetoothctl power "$state" >/dev/null 2>&1
        exit 1
        ;;
    *)
        exit 2
        ;;
esac
