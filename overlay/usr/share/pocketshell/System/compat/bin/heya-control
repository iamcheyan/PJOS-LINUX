#!/bin/sh
# BaseOS replacement for the ROCKNIX heya-control used by the settings bridge.
# Wi-Fi is only changed through an existing wpa_supplicant control socket;
# Bluetooth is reported unsupported when bluetoothctl cannot talk to D-Bus.
set -u
case "${1-}" in
    volume)
        value=${2-}
        case "$value" in ''|*[!0-9]*) exit 2 ;; esac
        [ "$value" -le 100 ] || exit 2
        mixer=$(command -v amixer 2>/dev/null || echo /bin/amixer)
        # The codec's DAC gain alone did not change the speaker loudness on this
        # panel; lineout is the analog stage that does. Drive both from the same
        # percentage so the UI, the wheel and the tick all agree.
        "$mixer" -q -c 0 set "digital volume" "${value}%" >/dev/null 2>&1 \
            || "$mixer" -q set "digital volume" "${value}%" >/dev/null 2>&1 || exit 1
        "$mixer" -q -c 0 set "lineout volume" "${value}%" >/dev/null 2>&1 || :
        # Zero really means silent: the amp stays enabled at 0% on this codec, so
        # close the speaker switch as well and reopen it on the next step.
        if [ "$value" -eq 0 ]; then
            "$mixer" -q -c 0 sset 'SPK' off >/dev/null 2>&1 || :
        else
            "$mixer" -q -c 0 sset 'SPK' on >/dev/null 2>&1 || :
        fi
        # One short tick per step, played at the level just set: the user hears
        # the volume land without looking at the panel.
        for beep in /storage/System/compat/share/audio/beep.wav \
                    /usr/share/pocketshell/System/compat/share/audio/beep.wav; do
            [ -f "$beep" ] || continue
            command -v aplay >/dev/null 2>&1 && aplay -q "$beep" >/dev/null 2>&1
            break
        done
        exit 0
        ;;
    brightness)
        value=${2-}
        case "$value" in ''|*[!0-9]*) exit 2 ;; esac
        [ "$value" -le 100 ] || exit 2
        # enhance_bright is not the backlight: baseos-panel drives dispdbg and
        # verifies the driver's read-back. Floor at the same 10 the helper uses.
        panel=/mnt/sdcard/System/bin/baseos-panel
        [ -x "$panel" ] || panel=/usr/sbin/baseos-panel
        [ -x "$panel" ] || exit 1
        level=$(( (value * 255 + 50) / 100 ))
        [ "$level" -ge 10 ] || level=10
        exec "$panel" level "$level"
        ;;
    wifi)
        state=${2-}
        case "$state" in on|off) ;; *) exit 2 ;; esac
        for iface in wlan0 wlan1; do
            if wpa_cli -i "$iface" ping >/dev/null 2>&1; then
                case "$state" in
                    on) wpa_cli -i "$iface" reconnect >/dev/null 2>&1 ;;
                    off) wpa_cli -i "$iface" disconnect >/dev/null 2>&1 ;;
                esac
                exit $?
            fi
        done
        echo "wi-fi control socket unavailable" >&2
        exit 1
        ;;
    bluetooth)
        state=${2-}
        case "$state" in on|off) ;; *) exit 2 ;; esac
        command -v bluetoothctl >/dev/null 2>&1 || exit 1
        bluetoothctl power "$state" >/dev/null 2>&1
        exit 1
        ;;
    *)
        exit 2
        ;;
esac
