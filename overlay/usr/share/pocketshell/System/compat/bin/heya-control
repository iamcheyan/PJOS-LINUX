#!/bin/sh
# BaseOS replacement for the ROCKNIX heya-control used by the settings bridge.
# Wi-Fi is only changed through an existing wpa_supplicant control socket;
# Bluetooth is reported unsupported when bluetoothctl cannot talk to D-Bus.
set -u
ctl=${PJOS_BASEOSCTL:-/usr/sbin/baseosctl}
case "$ctl" in /*) ;; *) exit 2 ;; esac
volume_state=${BASEOS_VOLUME_STATE:-/run/baseos-volume.percent}
[ -d /run ] || volume_state=/tmp/baseos-volume.percent
persistent_state=${BASEOS_VOLUME_PERSISTENT:-/storage/.config/baseos/volume.percent}
event_state=${BASEOS_VOLUME_EVENT:-/run/baseos-volume.sequence}
[ -d /run ] || event_state=/tmp/baseos-volume.sequence
case "${1-}" in
    volume-state)
        value=$(cat "$volume_state" 2>/dev/null || :)
        case "$value" in
            ''|*[!0-9]*)
                value=$(cat "$persistent_state" 2>/dev/null || :)
                ;;
        esac
        case "$value" in
            ''|*[!0-9]*) ;;
            *) if [ "$value" -le 100 ] 2>/dev/null; then echo "$value"; exit 0; fi ;;
        esac
        exec "$ctl" audio get-volume
        ;;
    volume)
        value=${2-}
        case "$value" in ''|*[!0-9]*) exit 2 ;; esac
        [ "$value" -le 100 ] || exit 2
        "$ctl" audio set-volume "$value" || exit $?
        # Publish the requested level only after a successful hardware write.
        printf '%s\n' "$value" > "$volume_state.$$" &&
            mv -f "$volume_state.$$" "$volume_state" || {
                rm -f "$volume_state.$$"
                exit 1
            }
        mkdir -p "${persistent_state%/*}" 2>/dev/null || :
        printf '%s\n' "$value" > "$persistent_state.$$" &&
            mv -f "$persistent_state.$$" "$persistent_state" 2>/dev/null || rm -f "$persistent_state.$$"
        event_state=${BASEOS_VOLUME_EVENT:-/run/baseos-volume.sequence}
        sequence=$(cat "$event_state" 2>/dev/null || :)
        case "$sequence" in ''|*[!0-9]*) sequence=0 ;; esac
        sequence=$((sequence + 1))
        if printf '%s\n' "$sequence" > "$event_state.$$"; then
            mv -f "$event_state.$$" "$event_state" 2>/dev/null || rm -f "$event_state.$$"
        fi
        # Play feedback tick unless suppressed (e.g. boot restoration)
        if [ "${3-}" != "--no-beep" ] && [ "${3-}" != "-q" ]; then
            for beep in /storage/System/compat/share/audio/beep.wav \
                        /usr/share/pocketshell/System/compat/share/audio/beep.wav; do
                [ -f "$beep" ] || continue
                command -v aplay >/dev/null 2>&1 && aplay -q "$beep" >/dev/null 2>&1
                break
            done
        fi
        exit 0
        ;;
    restore)
        value=$(cat "$persistent_state" 2>/dev/null || :)
        case "$value" in
            ''|*[!0-9]*) exit 0 ;;
        esac
        [ "$value" -le 100 ] || exit 0
        exec "$0" volume "$value" --no-beep
        ;;
    brightness-state)
        level=$("$ctl" display get-brightness) || exit $?
        case "$level" in ''|*[!0-9]*) exit 1 ;; esac
        [ "$level" -le 255 ] || exit 1
        echo "$(( (level * 100 + 127) / 255 ))"
        ;;
    brightness)
        value=${2-}
        case "$value" in [0-9]|[1-9][0-9]|100) ;; *) exit 2 ;; esac
        exec "$ctl" display set-brightness "$(( (value * 255 + 50) / 100 ))"
        ;;
    wifi)
        state=${2-}
        case "$state" in on|off) ;; *) exit 2 ;; esac
        for iface in wlan0 wlan1; do
            if wpa_cli -i "$iface" ping >/dev/null 2>&1; then
                case "$state" in
                    on) wpa_cli -i "$iface" reconnect >/dev/null 2>&1 ;;
                    off) wpa_cli -i "$iface" disconnect >/dev/null 2>&1 ;;
                esac
                exit $?
            fi
        done
        echo "wi-fi control socket unavailable" >&2
        exit 1
        ;;
    bluetooth)
        state=${2-}
        case "$state" in on|off) ;; *) exit 2 ;; esac
        command -v bluetoothctl >/dev/null 2>&1 || exit 1
        bluetoothctl power "$state" >/dev/null 2>&1
        exit 1
        ;;
    *)
        exit 2
        ;;
esac
