#!/bin/sh
# BaseOS mpv entry: the H700 build lives in compat/mpv with its own libs.
# Video goes through SDL2 mali-fbdev (/dev/fb0, there is no DRM) and audio
# through SDL audio.
#
# Because BaseOS has no window manager, pocket-linux-kms (Kanade UI) and mpv
# both write directly to /dev/fb0. pocket-linux-kms MUST be paused (SIGSTOP)
# during playback to prevent violent flickering between the video buffer
# (pan 0,0) and the UI list buffer (pan 0,480).
D=/storage/System/compat/mpv
PAN=/sys/class/graphics/fb0/pan
export LD_LIBRARY_PATH="$D:/storage/System/compat/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Gamepad mapping for RG34XX ANBERNIC-keys in SDL2:
# Physical A=b1 (GAMEPAD_ACTION_DOWN), Physical B=b0 (GAMEPAD_ACTION_RIGHT),
# Physical X=b2 (GAMEPAD_ACTION_LEFT), Physical Y=b3 (GAMEPAD_ACTION_UP),
# Select=b6 (GAMEPAD_BACK), Start=b7 (GAMEPAD_START), Menu=b8 (GAMEPAD_GUIDE)
export SDL_GAMECONTROLLERCONFIG='19000000010000000100000000016e01,ANBERNIC-keys,a:b1,b:b0,x:b2,y:b3,leftshoulder:b4,rightshoulder:b5,back:b6,start:b7,guide:b8,lefttrigger:b9,righttrigger:b10,leftx:a0,lefty:a1,rightx:a2,righty:a3,dpup:h0.1,dpright:h0.2,dpdown:h0.4,dpleft:h0.8,'

# Audio-only sessions leave the launcher alive for transport controls and
# screen-off operation. Arguments are per child, never a daemon-wide setting.
for arg in "$@"; do
    case "$arg" in
        --vo=null|--vid=no)
            AUDIO_MARKER=/run/baseos-audio-playing
            printf '%s\n' "$$" > "$AUDIO_MARKER"
            audio_cleanup() {
                [ "$(cat "$AUDIO_MARKER" 2>/dev/null)" = "$$" ] && rm -f "$AUDIO_MARKER"
                :
            }
            trap 'kill "${audio_pid:-}" 2>/dev/null; wait "${audio_pid:-}" 2>/dev/null; exit 143' TERM INT HUP
            trap 'audio_cleanup' EXIT
            "$D/mpv" --ao=sdl --really-quiet "$@" &
            audio_pid=$!
            wait "$audio_pid"
            exit $?
            ;;
    esac
done

pan=$(cat "$PAN" 2>/dev/null)

# Find and suspend pocket-linux-kms instances while video plays
POCKET_PIDS=$(pidof pocket-linux-kms 2>/dev/null)
if [ -n "$POCKET_PIDS" ]; then
    kill -STOP $POCKET_PIDS 2>/dev/null
fi

cleanup() {
    # Terminate input helper, restore pocket-linux-kms and pan offset
    [ -n "${keys_pid:-}" ] && kill -9 "$keys_pid" 2>/dev/null
    if [ -n "$POCKET_PIDS" ]; then
        kill -CONT $POCKET_PIDS 2>/dev/null
    fi
    [ -n "$pan" ] && [ "$pan" != "0,0" ] && echo "$pan" > "$PAN" 2>/dev/null
}

terminate_video() {
    # Keep the panel owner stopped until mpv has released the framebuffer.
    # A shell wait interrupted by TERM returns before its child exits.
    trap '' TERM INT HUP
    [ -z "${pid:-}" ] || kill "$pid" 2>/dev/null
    [ -z "${pid:-}" ] || wait "$pid" 2>/dev/null
    exit 143
}
trap 'terminate_video' TERM INT HUP
trap 'cleanup' EXIT

sock=
for arg in "$@"; do
    case "$arg" in
        --input-ipc-server=*) sock="${arg#--input-ipc-server=}" ;;
    esac
done

"$D/mpv" --vo=sdl --ao=sdl --fs --input-conf="$D/input.conf" --really-quiet "$@" &
pid=$!

# Companion key daemon: maps RG34XX physical buttons to mpv & audio
# B / Select / Start = quit, A = pause, Up/Down = volume, Left/Right = seek
if [ -x /storage/System/compat/bin/baseos-mpv-keys ]; then
    /storage/System/compat/bin/baseos-mpv-keys "$pid" "$sock" >/dev/null 2>&1 &
    keys_pid=$!
fi

wait $pid
rc=$?

exit $rc
