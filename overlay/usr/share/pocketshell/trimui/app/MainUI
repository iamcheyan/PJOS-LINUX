#!/bin/sh
export SDCARD=${PJOS_CARD_ROOT:-${SDCARD:-/mnt/SDCARD}}
SDCARD=${SDCARD%/}
case "$SDCARD" in /*) ;; *) exit 1 ;; esac
export PJOS_CARD_ROOT=$SDCARD
LOG=$SDCARD/pjos-boot.log
echo "==========================================" > "$LOG"
echo "PJOS (BaseOS) Booting on TrimUI Smart Pro" >> "$LOG"
echo "Timestamp: $(date)" >> "$LOG"
echo "==========================================" >> "$LOG"

# 1. Emergency fallback flag
if [ -f "$SDCARD/.boot_stock" ]; then
    echo "Fallback flag detected. Booting stock TrimUI..." >> "$LOG"
    exec /usr/trimui/bin/MainUI
fi

# 2. Setup paths and environment
export PJOS_PROFILE_DIR=${PJOS_PROFILE_DIR:-$SDCARD/System/profile}
export DAL_DIR=${DAL_DIR:-$SDCARD/System/dal}
export DAL_LIB=${DAL_LIB:-$SDCARD/System/dal.sh}
export PATH=$SDCARD/System/bin:$SDCARD/System/compat/bin:$SDCARD/System:$SDCARD/System/dal:/usr/trimui/bin:$PATH
export LD_LIBRARY_PATH=$SDCARD/System/compat/lib:/usr/trimui/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export POCKETJS_HOME=$SDCARD/System/pocketjs

# Validate the composed profile before starting any hardware-facing service.
[ -r "$DAL_LIB" ] || { echo "Missing DAL: $DAL_LIB" >> "$LOG"; exit 1; }
. "$DAL_LIB" || { echo "Unable to load DAL" >> "$LOG"; exit 1; }
dal_init || { echo "Invalid PJOS profile" >> "$LOG"; exit 1; }
board=$(dal_meta board) && soc=$(dal_meta soc) && mode=$(dal_meta firmware.mode) || exit 1
[ "$mode" = card ] || { echo 'Image profile in card launcher' >>"$LOG"; exit 1; }
# Validate the declared SoC against the live tree before accessing hardware.
matched=0
for compat in $(dal_meta soc.compatible); do
    tr '\000' '\n' </proc/device-tree/compatible | grep -Fxq "$compat" && matched=1
done
[ "$matched" = 1 ] || { echo "Incompatible SoC: $soc" >>"$LOG"; exit 1; }
DISPLAY_NODE=$(dal_display_node) && [ -c "$DISPLAY_NODE" ] || exit 1
case $(dal_meta display.backend) in fbdev) display_flag=--fb;; drm) display_flag=--card;; *) exit 1;; esac
policy=$(dal_meta power.long_press) || exit 1
# Never install links or libraries on the internal root. The vendor launcher
# supplies the storage mount; runtime state goes on tmpfs.
export PJOS_BASEOSCTL="$SDCARD/System/baseosctl"
export PJOS_RUN_ROOT=/tmp/pjos-state
mkdir -p "$PJOS_RUN_ROOT/run" || exit 1

# Generate the native app stub without moving the vendor Apps directory.
if [ -d "$SDCARD/apps/Zircon" ] || [ -d "$SDCARD/apps/zircon" ] || [ -d "$SDCARD/Apps/Zircon" ] || [ -d "$SDCARD/Apps/zircon" ]; then
    mkdir -p "$SDCARD/apps" && [ -f "$SDCARD/apps/zircon.pocket" ] || touch "$SDCARD/apps/zircon.pocket" 2>/dev/null || :
fi

# 3. Ensure hardware daemons are alive (singleton)
if ! pgrep trimui_inputd > /dev/null 2>&1; then
    echo "Starting trimui_inputd..." >> "$LOG"
    /usr/trimui/bin/trimui_inputd &
    sleep 0.5
fi
if ! pgrep trimui_scened > /dev/null 2>&1; then
    echo "Starting trimui_scened..." >> "$LOG"
    /usr/trimui/bin/trimui_scened &
fi
# The gamepad can appear only after the vendor input daemon has registered it.
tries=0
while ! PAD_DEV=$(dal_input_node gamepad); do
    tries=$((tries + 1)); [ "$tries" -lt 20 ] || exit 1
    sleep 0.1
done
POWER_DEV=$(dal_input_node power) && VOLUME_DEV=$(dal_input_node keyboard) || exit 1
printf 'board=%s soc=%s profile=%s power=%s pad=%s volume=%s\n' \
    "$board" "$soc" "$PJOS_PROFILE_DIR" "$POWER_DEV" "$PAD_DEV" "$VOLUME_DEV" >>"$LOG"
BASEOS_HOTKEY_DAEMON="$SDCARD/System/baseos-hotkeys" \
    "$SDCARD/System/baseos-hotkey-service" >>"$LOG" 2>&1 &

# 4. Run game library scan in background
POCKETSHELL_GAMES_STATE="$SDCARD/pocketshell/library" "$SDCARD/System/compat/bin/pocketshell-games" scan >> "$LOG" 2>&1 &

# 5. Main Supervisor Loop (Frontend <-> Emulator handoff)
cd "$POCKETJS_HOME" || exit 1
FAIL_COUNT=0

while true; do
    if ! pgrep trimui-volumed > /dev/null 2>&1 && [ -x "$SDCARD/System/bin/trimui-volumed" ]; then
        "$SDCARD/System/bin/trimui-volumed" "$VOLUME_DEV" "$SDCARD/System/compat/bin/heya-control" &
    fi
    # Check if a game was requested
    ACTIVE_MARKER=$SDCARD/System/pocketjs/active
    if [ -s "$ACTIVE_MARKER" ]; then
        ROM_REQ=$(head -n 1 "$ACTIVE_MARKER" | tr -d '\r')
        # Native applications hand the panel to their own launcher instead of
        # an emulator: @zircon or zircon is written by compat/bin/pocketjs-native-launch.
        case "$ROM_REQ" in
            @zircon|zircon|Zircon)
                echo "Supervisor: native app requested: zircon" >> "$LOG"
                ZIRCON_DIR=
                for cand in "$SDCARD/apps/Zircon" "$SDCARD/Apps/Zircon" "$SDCARD/apps/zircon" "$SDCARD/Apps/zircon"; do
                    if [ -d "$cand" ]; then
                        ZIRCON_DIR="$cand"
                        break
                    fi
                done
                if [ -n "$ZIRCON_DIR" ] && [ -x "$ZIRCON_DIR/launch.sh" ]; then
                    echo "Starting Zircon at $(date)..." >> "$LOG"
                    "$ZIRCON_DIR/launch.sh" >> "$LOG" 2>&1
                    echo "Zircon exited at $(date)" >> "$LOG"
                else
                    echo "Supervisor: Zircon launch script missing: $ZIRCON_DIR/launch.sh" >> "$LOG"
                fi
                rm -f "$ACTIVE_MARKER"
                sleep 1
                continue ;;
        esac
        echo "Supervisor: active game requested: $ROM_REQ" >> "$LOG"
        ROM_PATH=$ROM_REQ
        case "$ROM_REQ" in
            /*) ;; # The player validates absolute paths and resolves legacy aliases.
            *)
                for d in "$SDCARD"/[rR][oO][mM][sS] "$SDCARD/content/games"; do
                    found=$(find "$d" -type f -name "$ROM_REQ" 2>/dev/null | head -n 1)
                    if [ -n "$found" ]; then
                        ROM_PATH=$found
                        break
                    fi
                done ;;
        esac
        "$SDCARD/System/compat/bin/pocket-game-play" "$ROM_PATH" >> "$LOG" 2>&1
        echo "Emulator handoff for $ROM_PATH exited with code $? at $(date)" >> "$LOG"
        rm -f "$ACTIVE_MARKER"
        sleep 1
        continue
    fi

    echo "Starting pocket-linux-kms at $(date)..." >> "$LOG"
    START_TIME=$(date +%s)
    ./bin/pocket-linux-kms --package ./apps/boot.pocket "$display_flag" "$DISPLAY_NODE" --input "$PAD_DEV" >> "$LOG" 2>&1
    EXIT_CODE=$?
    END_TIME=$(date +%s)
    ELAPSED=$((END_TIME - START_TIME))

    echo "pocket-linux-kms exited with code $EXIT_CODE after ${ELAPSED}s at $(date)" >> "$LOG"

    # Check for game launch request immediately after exit
    if [ -s "$ACTIVE_MARKER" ]; then
        FAIL_COUNT=0
        continue
    fi

    # Check for system power actions
    if [ -f /tmp/pjos_shutdown ]; then
        echo "Clean shutdown requested." >> "$LOG"
        poweroff
        exit 0
    elif [ -f /tmp/pjos_reboot ]; then
        echo "Clean reboot requested." >> "$LOG"
        reboot
        exit 0
    fi

    # If it ran for more than 10 seconds, reset failure count
    if [ "$ELAPSED" -ge 10 ]; then
        FAIL_COUNT=0
    else
        FAIL_COUNT=$((FAIL_COUNT + 1))
    fi

    # Fallback safety net: 3 fast consecutive crashes without game request
    if [ "$FAIL_COUNT" -ge 3 ]; then
        echo "Repeated crashes detected ($FAIL_COUNT). Falling back to stock TrimUI..." >> "$LOG"
        exec /usr/trimui/bin/MainUI
    fi

    sleep 1
done
