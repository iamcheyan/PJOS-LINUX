#!/bin/sh
# The frontend session, respawned by busybox init. Replaces the whole stock
# chain (launcher.service -> launcher.sh -> loadapp.sh -> dmenu_ln -> boot
# shim). Runs NextUI, Slot, spruceOS or a generic frontend from the card.

# Export release metadata for installers and every frontend entry point.
if [ -r /etc/baseos-release ]; then
	set -a
	. /etc/baseos-release
	set +a
fi

SD=/mnt/sdcard
. /usr/share/baseos/boot-log.sh
select_boot_log
INSTALL_FAILED=0
CARD_MISSING=0

# One persistent marker is the entire steady-state migration cost: a shell
# builtin, no spawned helper, firmware reads, hashes or backup checks. A fresh
# image records its already-optimised state once. Maintenance boots never write
# disks owned by the USB host. Keep this before update-trial confirmation.
# The marker is boot-pair-v2: a card that finished the earlier gzip migration
# (boot-gzip-v1) runs the helper once more to receive the faster pair.
# The native loader has one marker per generation, named after it.
boot_steps_done=1
[ -e /data/boot-pair-v2/complete ] || boot_steps_done=0
if [ -r /usr/share/baseos/native/generation ]; then
	read -r native_generation < /usr/share/baseos/native/generation || native_generation=
	[ -e "/data/boot-native-v1/done-$native_generation" ] || boot_steps_done=0
fi
if [ "$boot_steps_done" = 0 ] && [ ! -s /run/usb-storage-device ] \
	&& [ -x /usr/sbin/baseos-boot-migrate ]; then
	if ! BASEOS_BOOT_LOG="$LOG" /usr/sbin/baseos-boot-migrate; then
		# Failure with an unverified restore must not trigger a reboot or trial
		# confirmation. ADB started by rcS stays available for recovery.
		while :; do sleep 3600; done
	fi
fi

# A frontend session starting is what ends a system-update trial: the OS came
# up far enough to hand off. Keying it here rather than on the frontend exec is
# deliberate — a card with no frontend is a perfectly healthy OS, and keying it
# later would make that state look like a failed update and roll back forever.
# An OS without its dynamic loader is not healthy, whatever is on the card: the
# /usr/lib image did not mount, and only the rollback can repair that.
[ -x /usr/sbin/baseos-update ] && [ -e /lib/ld-linux-aarch64.so.1 ] \
	&& /usr/sbin/baseos-update confirm 2>/dev/null

# 1.236 -> 1.24: two decimals are plenty for a person reading the log.
seconds() {
	sec_whole=${1%%.*} sec_part=
	[ "$sec_whole" = "$1" ] || sec_part=${1#*.}
	sec_part=${sec_part}000
	sec_part=${sec_part%"${sec_part#???}"}
	sec_cs=$(( (${sec_whole:-0} * 1000 + 1$sec_part - 1000 + 5) / 10 ))
	printf '%d.%02d' $((sec_cs / 100)) $((sec_cs % 100))
}

# Install the runtime paired with this SYSTEM before the external frontend
# starts. Use a same-directory temporary file and atomic rename so a power loss
# cannot leave a truncated executable on the user's card.
if mountpoint -q "$SD" 2>/dev/null \
    && [ -x /usr/share/baseos/pocketjs/pocket-linux-kms ]; then
    runtime="$SD/System/pocketjs/bin/pocket-linux-kms"
    if [ -f "$SD/System/launch_frontend.sh" ] && [ -d "${runtime%/*}" ]; then
        if ! cmp -s /usr/share/baseos/pocketjs/pocket-linux-kms "$runtime"; then
            runtime_tmp="$runtime.baseos-new"
            if cp /usr/share/baseos/pocketjs/pocket-linux-kms "$runtime_tmp" \
                && chmod 0755 "$runtime_tmp" \
                && cmp -s /usr/share/baseos/pocketjs/pocket-linux-kms "$runtime_tmp" \
                && mv -f "$runtime_tmp" "$runtime"; then
                log "installed SYSTEM-matched PocketJS evdev runtime on frontend card"
            else
                rm -f "$runtime_tmp"
                log "WARNING: failed to install PocketJS runtime; keeping card copy"
            fi
        fi
    fi
fi

if mountpoint -q "$SD" 2>/dev/null \
    && [ -f /usr/share/pocketshell/System/pocketjs/apps/gamehub.pocket ] \
    && [ -d "$SD/System/pocketjs/apps" ]; then
    install -m 0644 /usr/share/pocketshell/System/pocketjs/apps/gamehub.pocket \
        "$SD/System/pocketjs/apps/gamehub.pocket.new"
    mv -f "$SD/System/pocketjs/apps/gamehub.pocket.new" "$SD/System/pocketjs/apps/gamehub.pocket"
fi

# Which loader started this boot, and a diagnostics block when it is useful:
# read only, at the lowest priority, once per boot, after the menu is up.
start_diagnostics() {
	[ -x /usr/sbin/baseos-diag ] && [ ! -e /run/baseos-diag-boot ] || return 0
	BASEOS_BOOT_LOG="$LOG" nice -n 19 ionice -c 3 /usr/sbin/baseos-diag --boot \
		</dev/null >/dev/null 2>&1 &
}

important_splash() {
	[ -x /usr/bin/baseos-splash ] \
		&& /usr/bin/baseos-splash --important "$@" 2>/dev/null
}

# rcS has kept the selected device unmounted and handed it to the USB gadget.
# Never race the host by mounting it or starting a frontend.
# The host owns the volume until the next reboot; the static message names the
# critical safety action without adding animation or a resident UI.
if [ -s /run/usb-storage-device ]; then
	log "USB storage mode — frontend intentionally stopped"
	important_splash -1 "STARTING USB STORAGE"
	storage_wait=0
	while [ ! -e /run/usb-storage-ready ] \
		&& [ ! -e /run/usb-storage-failed ] \
		&& [ "$storage_wait" -lt 30 ]; do
		sleep 1
		storage_wait=$((storage_wait + 1))
	done
	if [ -e /run/usb-storage-ready ]; then
		important_splash -1 "USB STORAGE: EJECT BEFORE RESTART"
	else
		log "USB storage gadget did not become ready"
		important_splash -1 "USB STORAGE FAILED: POWER OFF"
	fi
	while :; do sleep 3600; done
fi

# The card should already be mounted by rcS; retry here covers slow cards
# and hot re-insertion after an unmount.
n=0
while ! mountpoint -q "$SD" 2>/dev/null; do
	if [ "$n" -ge 15 ]; then
		log "no card mounted after ${n}s"
		important_splash -1 "INSERT SD CARD"
		CARD_MISSING=1
		break
	fi
	for dev in /dev/mmcblk1p1 /dev/mmcblk0p7; do
		[ -b "$dev" ] || continue
		mount -t vfat -o rw,utf8,noatime,shortname=mixed "$dev" "$SD" 2>/dev/null && break
		mount -t auto -o noatime "$dev" "$SD" 2>/dev/null && break
	done
	mountpoint -q "$SD" 2>/dev/null && break
	sleep 1
	n=$((n + 1))
done

# Update flow: same triggers as the old boot shim (02-boot-and-installer.md).
if mountpoint -q "$SD" 2>/dev/null; then
	select_boot_log
	flush_early_boot_log
	ZIP="$SD/MinUI.zip"
	LAUNCH="$SD/.system/h700/paks/MinUI.pak/launch.sh"
	HAVE_PAKZ=0
	for z in "$SD"/*.pakz; do [ -f "$z" ] && HAVE_PAKZ=1 && break; done
	if [ -f "$ZIP" ] || [ "$HAVE_PAKZ" = 1 ]; then
		# NextUI's installer can't draw its own UI on base OS: its show2.elf
		# needs libSDL2/_image/_ttf, which base OS doesn't ship in /usr/lib (the
		# stock OS did) and NextUI's own SDL2 isn't extracted yet when it runs.
		# So paint one static install/update pill and let the (~1 min) work run
		# under it. Deliberately NOT animated: a background draw loop raced
		# NextUI's first frame and left the splash stuck over its static menu.
		if [ -f "$LAUNCH" ]; then
			important_splash 85 "UPDATING FRONTEND"
		else
			important_splash 85 "INSTALLING FRONTEND"
		fi
		if [ ! -f "$SD/.tmp_update/h700.sh" ] && [ -f "$ZIP" ]; then
			log "bootstrapping installer from MinUI.zip"
			unzip -o "$ZIP" ".tmp_update/*" -d "$SD" >> "$LOG" 2>&1
			log "bootstrap unzip exited $?"
		fi
		if [ -f "$SD/.tmp_update/h700.sh" ]; then
			log "running installer/updater"
			if sh "$SD/.tmp_update/h700.sh" >> "$LOG" 2>&1; then
				log "installer exited 0"
			else
				installer_status=$?
				log "installer exited $installer_status"
				important_splash -1 "INSTALL FAILED"
				INSTALL_FAILED=1
			fi
		else
			log "installer missing after bootstrap"
			important_splash -1 "INSTALL FAILED"
			INSTALL_FAILED=1
		fi
	fi
fi

LAUNCH=
FRONTEND=
LAUNCH_TYPE=script
# Select Generic, Slot, NextUI, then spruceOS after any pending install/update.
# Prefer the generic binary over its shell launcher.
if [ -f "$SD/System/frontend" ]; then
	LAUNCH="$SD/System/frontend"
	FRONTEND=generic
	LAUNCH_TYPE=binary
elif [ -f "$SD/System/launch_frontend.sh" ]; then
	LAUNCH="$SD/System/launch_frontend.sh"
	FRONTEND=generic
elif [ -f "$SD/System/slot" ]; then
	LAUNCH="$SD/System/slot"
	FRONTEND=slot
	LAUNCH_TYPE=binary
elif [ -f "$SD/.system/h700/paks/MinUI.pak/launch.sh" ]; then
	LAUNCH="$SD/.system/h700/paks/MinUI.pak/launch.sh"
	FRONTEND=nextui
elif [ -f /mnt/SDCARD/spruce/scripts/runtime.sh ]; then
	# rcS aliases /mnt/SDCARD to the selected card. Spruce uses that path
	# for its runtime and helpers; invoke the script without needing chmod.
	LAUNCH=/mnt/SDCARD/spruce/scripts/runtime.sh
	FRONTEND=spruce
fi
if [ "$CARD_MISSING" -eq 0 ] && [ -f "$LAUNCH" ]; then
	if [ "$FRONTEND" = slot ]; then
		export SLOT_ROOT="$SD"
	fi
	if [ "$FRONTEND" = slot ] || [ "$FRONTEND" = generic ]; then
		cd "$SD" || exit 1
	fi
	# rcS loads mali_kbase in the background; make sure /dev/mali0 exists
	# before the frontend initializes graphics (near-always already true).
	m=0
	while [ ! -e /dev/mali0 ] && [ "$m" -lt 30 ]; do
		sleep 0.1 2>/dev/null || sleep 1
		m=$((m + 1))
	done
	# A plain name for the log: the pak's name (MinUI for NextUI's MinUI.pak),
	# else the frontend's own.
	case "$LAUNCH" in
		*/*.pak/*) frontend_name=${LAUNCH%.pak/*} frontend_name=${frontend_name##*/} ;;
		*)
			case "$FRONTEND" in
				slot) frontend_name=Slot ;;
				spruce) frontend_name=spruceOS ;;
				*) frontend_name="custom frontend" ;;
			esac ;;
	esac
	gpu_wait=
	[ "$m" -eq 0 ] || gpu_wait=", after $((m / 10)).$((m % 10)) s waiting for the GPU"
	# Keep the first handoff across respawns and record it in the readable log.
	if [ ! -s /run/boot-frontend-exec ]; then
		# boot-clock validates counter access/frequency at the first handoff.
		# Keep BOOTTIME for the existing marker/budget. The split in the log
		# uses the unadjusted clock so NTP cannot masquerade as boot work.
		boot_pre= boot_post= boot_total=
		if ! { [ -x /usr/sbin/boot-clock ] \
			&& /usr/sbin/boot-clock > /run/boot-clock-handoff 2>/dev/null \
			&& read -r boot_uptime boot_pre boot_post boot_total < /run/boot-clock-handoff; }; then
			boot_pre= boot_post= boot_total=
			read -r boot_uptime boot_idle < /proc/uptime || boot_uptime=
		fi
		[ -z "$boot_uptime" ] || printf '%s\n' "$boot_uptime" > /run/boot-frontend-exec 2>/dev/null || :
		if [ -n "$boot_total" ]; then
			log "Startup: $(seconds "$boot_pre") s before Linux, $(seconds "$boot_post") s Linux to menu, $(seconds "$boot_total") s total ($frontend_name$gpu_wait)"
		elif [ -n "$boot_uptime" ]; then
			log "Startup: $(seconds "$boot_uptime") s Linux to menu ($frontend_name$gpu_wait)"
		fi
		start_diagnostics
	else
		log "Frontend started again: $frontend_name$gpu_wait"
	fi
	if [ "$LAUNCH_TYPE" = binary ]; then
		# Binaries use the glibc AArch64 runtime. Use the system
		# loader so a copied binary needs no executable bit or chmod on the
		# card. Frontend output stays in RAM and is replaced on each launch.
		exec /lib/ld-linux-aarch64.so.1 "$LAUNCH" > "/tmp/$FRONTEND.log" 2>&1
	fi
	if [ "$FRONTEND" = generic ]; then
		exec /bin/sh "$LAUNCH" > /tmp/generic.log 2>&1
	fi
	exec /bin/sh "$LAUNCH"
fi

# No frontend on the card. BaseOS ships none — the user copies one (e.g.
# NextUI's MinUI.zip or Slot's extracted System folder) onto the card (see the
# README.txt expand-storage left on it). Show a clear prompt and wait for a
# reboot; init respawns us, so pace the retry.
if [ "$CARD_MISSING" -eq 1 ]; then
	log "no card mounted — waiting for insertion"
elif [ "$INSTALL_FAILED" -eq 1 ]; then
	log "frontend install failed — waiting to retry"
else
	log "no frontend on card — waiting for the user to add one"
	important_splash -1 "ADD FRONTEND TO SD CARD"
fi
[ "$CARD_MISSING" -eq 1 ] || start_diagnostics
sleep 5
exit 1
