#!/bin/sh
# Turn the panel backlight off after a period without input, and restore it on
# the next keypress. The backlight is the only thing touched for screen blanking:
# nothing is suspended, unmounted, throttled or stopped, so playback, downloads
# and the frontend keep running while the screen is dark.
#
# Screen timeout, in this order of precedence:
#   /storage/.config/baseos/screen-idle.conf   timeout = 30s      (BaseOS)
#   /storage/.config/pocketjs/runtime.conf     [sleep] timeout=30s (launcher UI)
# Accepted values: never, 10s, 30s, 1m, 5m, 15m, 30m, 1h. Default: 30 seconds.
#
# Auto power-off (idle device stop), in this order of precedence:
#   /storage/.config/baseos/screen-idle.conf   auto_stop_timeout = never  (alias: poweroff_timeout)
#   /storage/.config/pocketjs/runtime.conf     [power] timeout=never
# Accepted values: never/off/none/0, 1m, 5m, 10m, 15m, 30m, 1h, 2h. Default: never.
# Uses the same input-idle stamp as screen blanking; any keypress resets it.
#
# BaseOS has no /sys/class/backlight: the vendor kernel exposes panel brightness
# through the display attribute node. The path is probed rather than assumed so
# a kernel that moves it degrades to "no blanking" instead of writing garbage.
set -u

STAMP=/run/screen-idle.stamp
PIDFILE=/run/baseos-screen-idle.pid
LOG=/tmp/baseos-screen-idle.log
DEFAULT_TIMEOUT=30s
# Candidate backlight nodes, most specific first.
BACKLIGHT_NODES="
/sys/class/disp/disp/attr/enhance_bright
/sys/class/disp/disp/attr/lcd_bright
"

log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >>"$LOG" 2>/dev/null || :; }

seconds() {
    duration=$1
    multiplier=1
    case "$duration" in
        never|off|none) echo 0; return ;;
        *s) duration=${duration%s} ;;
        *m) duration=${duration%m}; multiplier=60 ;;
        *h) duration=${duration%h}; multiplier=3600 ;;
    esac
    # Malformed power settings must never become a 30-second shutdown. Validate
    # before arithmetic (which would otherwise terminate the daemon on junk).
    case "$duration" in
        ''|*[!0-9]*) echo "${2:-30}"; return ;;
    esac
    # Strip leading zeroes so POSIX shells do not interpret 08/09 as octal.
    while [ "${duration#0}" != "$duration" ]; do duration=${duration#0}; done
    duration=${duration:-0}
    [ "${#duration}" -le 7 ] || { echo "${2:-30}"; return; }
    echo $(( duration * multiplier ))
}

configured_timeout() {
    value=
    if [ -r /storage/.config/baseos/screen-idle.conf ]; then
        value=$(sed -n 's/^[[:space:]]*timeout[[:space:]]*=[[:space:]]*//p' \
            /storage/.config/baseos/screen-idle.conf | head -1)
    fi
    if [ -z "$value" ] && [ -r /storage/.config/pocketjs/runtime.conf ]; then
        value=$(awk '
            /^\[/ { section = $0 }
            section == "[sleep]" && /^[[:space:]]*timeout[[:space:]]*=/ {
                sub(/^[^=]*=[[:space:]]*/, ""); print; exit
            }' /storage/.config/pocketjs/runtime.conf)
    fi
    [ -n "$value" ] || value=$DEFAULT_TIMEOUT
    seconds "$value"
}

# Auto power-off after sustained input inactivity. "never"/0 disables it.
# Reads auto_stop_timeout from screen-idle.conf, or [power] timeout from the
# launcher's runtime.conf (same precedence pattern as screen timeout).
configured_auto_stop_timeout() {
    value=
    if [ -r /storage/.config/baseos/screen-idle.conf ]; then
        value=$(sed -n 's/^[[:space:]]*\(auto_stop_timeout\|auto_off_timeout\|poweroff_timeout\)[[:space:]]*=[[:space:]]*//p' \
            /storage/.config/baseos/screen-idle.conf | head -1)
    fi
    if [ -z "$value" ] && [ -r /storage/.config/pocketjs/runtime.conf ]; then
        value=$(awk '
            /^\[/ { section = $0 }
            section == "[power]" && /^[[:space:]]*timeout[[:space:]]*=/ {
                sub(/^[^=]*=[[:space:]]*/, ""); print; exit
            }' /storage/.config/pocketjs/runtime.conf)
    fi
    [ -n "$value" ] || value=never
    seconds "$value" 0
}

find_backlight() {
    for node in $BACKLIGHT_NODES; do
        [ -w "$node" ] && { echo "$node"; return 0; }
    done
    for node in /sys/class/backlight/*/brightness; do
        [ -w "$node" ] && { echo "$node"; return 0; }
    done
    return 1
}

PANEL=/usr/sbin/baseos-panel
[ -x /mnt/sdcard/System/bin/baseos-panel ] && PANEL=/mnt/sdcard/System/bin/baseos-panel
[ -x "$PANEL" ] || PANEL=

# The driver's backlight. enhance_bright is not that value; read it only when
# the helper is missing. "level" with no argument prints the live PWM level.
read_level() {
    if [ -n "$PANEL" ]; then
        v=$("$PANEL" level 2>/dev/null || true)
        case "$v" in
        ''|*[!0-9]*) ;;
        *) printf '%s\n' "$v"; return 0 ;;
        esac
    fi
    if [ -n "${BL:-}" ] && [ -r "$BL" ]; then
        awk '{print $1; exit}' "$BL" 2>/dev/null || true
        return 0
    fi
    echo 0
}

BL=$(find_backlight || true)
if [ -z "$BL" ] && [ -z "$PANEL" ]; then
    log "no writable backlight node; idle blanking disabled"
    exit 0
fi
log "panel helper: ${PANEL:-none (brightness node only)}"
log "backlight node: ${BL:-none}"
# Single instance: a frontend restart must replace the previous helper, not stack
# another one on top of it (each stack would fight over the panel).
if [ -r "$PIDFILE" ]; then
    previous=$(cat "$PIDFILE" 2>/dev/null || :)
    case "$previous" in
    ''|*[!0-9]*) : ;;
    *)
        if kill -0 "$previous" 2>/dev/null; then
            log "already running as $previous; exiting"
            exit 0
        fi
        ;;
    esac
fi
printf '%s\n' "$$" > "$PIDFILE" 2>/dev/null || :

# Read the resting level once. Never restore to 0: a saved 0 would leave the
# panel dark after the first wake. Prefer the level file the panel helper
# keeps, which is the same number L2/R2 and the power key restore.
saved=$(read_level)
case "$saved" in ''|*[!0-9]*) saved=0 ;; esac
if [ "$saved" -eq 0 ] && [ -r /run/panel.level ]; then
    saved=$(awk '{print $1; exit}' /run/panel.level 2>/dev/null || echo 0)
    case "$saved" in ''|*[!0-9]*) saved=0 ;; esac
fi
if [ "$saved" -eq 0 ]; then
    saved=120
fi
log "resting level: $saved"

touch "$STAMP" 2>/dev/null || : >"$STAMP"

# One blocking reader per input device: each 24-byte input_event that arrives
# refreshes the idle stamp. evdev allows several readers, so this does not steal
# events from the runtime.
spawn_readers() {
    # Drop devices that were removed. Their reader exits on its own, but keeping the
    # name here would stop the device from being watched again when it comes back.
    for known in $READERS; do
        [ -e "$known" ] && continue
        READERS=$(printf '%s\n' $READERS | grep -vx "$known" | tr '\n' ' ')
        log "stopped watching $known (removed)"
    done
    for dev in /dev/input/event*; do
        [ -e "$dev" ] || continue
        case " $READERS " in *" $dev "*) continue ;; esac
        (
            buffer="/tmp/.screen-idle-${dev##*/}"
            while :; do
                timeout 3600 dd if="$dev" bs=24 count=1 of="$buffer" 2>/dev/null || :
                if [ -s "$buffer" ]; then
                    touch "$STAMP" 2>/dev/null || :
                    : > "$buffer"
                else
                    # dd returns instantly when the device is gone. Refreshing the stamp
                    # here would keep the panel lit forever (and burn the CPU), so brake,
                    # and stop watching a node that disappeared.
                    [ -e "$dev" ] || break
                    sleep 1
                fi
            done
            rm -f "$buffer"
        ) &
        READERS="$READERS $dev"
        log "watching $dev"
    done
}

READERS=
spawn_readers

blanked=0
while :; do
    # Active video/media playback must not be blanked or shut down while playing.
    if pidof mpv >/dev/null 2>&1; then
        touch "$STAMP" 2>/dev/null || :
        sleep 5
        continue
    fi

    # Power-off is independent of screen blanking. Evaluate it before either the
    # "never blank" or manual panel-off branches, which would otherwise skip
    # this loop's later idle check forever.
    now=$(date +%s)
    last=$(stat -c %Y "$STAMP" 2>/dev/null || echo 0)
    idle=$(( now - last ))
    auto_stop_timeout=$(configured_auto_stop_timeout)
    if [ "$auto_stop_timeout" -gt 0 ] && [ "$idle" -ge "$auto_stop_timeout" ]; then
        log "auto power-off after ${idle}s idle (timeout ${auto_stop_timeout}s)"
        # This card-side helper records the ROM/app before the OS poweroff path
        # runs; the image's read-only poweroff binary may predate the hook.
        saver=/mnt/sdcard/System/bin/baseos-save-state
        [ -x "$saver" ] || saver=/storage/System/bin/baseos-save-state
        [ ! -x "$saver" ] || "$saver" >/dev/null 2>&1 || :
        sync
        if [ -x /usr/sbin/baseos-poweroff ]; then
            /usr/sbin/baseos-poweroff 2>/dev/null || /sbin/poweroff 2>/dev/null || :
        else
            /sbin/poweroff 2>/dev/null || :
        fi
        sleep 60
        continue
    fi

    timeout=$(configured_timeout)
    if [ "$timeout" -le 0 ]; then
        if [ "$blanked" = 1 ]; then
            if [ -n "$PANEL" ] && "$PANEL" on; then
                blanked=0
                log "blanking disabled; panel restored"
            elif [ -n "$BL" ] && printf '%s\n' "$saved" >"$BL" 2>/dev/null; then
                blanked=0
                log "blanking disabled; panel restored"
            fi
        fi
        sleep 5
        continue
    fi

    # The power key turns the panel off on purpose. Leave the node alone until it is
    # toggled back, otherwise the idle loop fights the hotkey daemon every second.
    # baseos-panel off also creates this marker for our own automatic blank.
    # Keep ownership in that case so the next input reaches the wake branch.
    if [ -e /run/panel.off ] && [ "$blanked" = 0 ]; then
        blanked=0
        sleep 1
        continue
    fi

    # Track manual brightness changes (settings slider, GBA L2/R2) so a fallback
    # wake restores what the user chose, not the level captured at boot.
    # baseos-panel off/on already persist this in /run/panel.level.
    if [ "$blanked" = 0 ]; then
        current=$(read_level)
        case "$current" in ''|*[!0-9]*) ;; *) [ "$current" -gt 0 ] && saved=$current ;; esac
    fi

    if [ "$blanked" = 0 ] && [ "$idle" -ge "$timeout" ]; then
        if [ -n "$PANEL" ] && "$PANEL" off; then
            blanked=1; log "panel off after ${idle}s idle"
        elif [ -n "$BL" ] && printf '0\n' >"$BL" 2>/dev/null; then
            blanked=1; log "panel dimmed to 0 after ${idle}s idle"
        fi
    elif [ "$blanked" = 1 ] && [ "$idle" -lt "$timeout" ]; then
        if [ -n "$PANEL" ] && "$PANEL" on; then
            blanked=0; log "panel on after input"
        elif [ -n "$BL" ] && printf '%s\n' "$saved" >"$BL" 2>/dev/null; then
            blanked=0; log "panel restored after input"
        fi
    fi

    # Pick up devices plugged in after boot.
    [ $(( now % 30 )) -lt 2 ] && spawn_readers
    sleep 1
done
