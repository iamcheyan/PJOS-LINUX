#!/bin/sh
# Minimal systemd compatibility shim for the base OS (no systemd on board).
# Covers exactly the calls NextUI's h700 scripts make:
#   systemctl stop NetworkManager                         -> no-op ok
#   systemctl stop wpa_supplicant[@...]                    -> terminate and wait
#   systemctl is-active [--quiet] bluetooth                -> pidof bluetoothd
#   systemctl start|restart bluetooth                      -> dbus + bluetoothd
#   systemctl stop bluetooth                               -> kill bluetoothd
# Everything else: succeed quietly (callers guard with `|| true` anyway).

cmd=""
unit=""
for arg in "$@"; do
	case "$arg" in
		--*) ;;
		*)
			if [ -z "$cmd" ]; then cmd="$arg"; else unit="$arg"; fi
			;;
	esac
done

ensure_dbus() {
	pidof dbus-daemon >/dev/null 2>&1 && return 0
	mkdir -p /run/dbus
	[ -s /run/machine-id ] || dbus-uuidgen > /run/machine-id 2>/dev/null
	dbus-daemon --system 2>/dev/null
	n=0
	while [ ! -S /run/dbus/system_bus_socket ] && [ "$n" -lt 20 ]; do
		sleep 0.1 2>/dev/null || sleep 1
		n=$((n + 1))
	done
}

stop_supplicant() {
	# NextUI calls this before starting a replacement. Returning before the old
	# daemon exits lets its control-socket cleanup race the new daemon's startup.
	wpa_pids=$(pidof wpa_supplicant 2>/dev/null) || return 0
	[ -n "$wpa_pids" ] || return 0
	kill $wpa_pids 2>/dev/null || true
	wpa_wait=0
	while [ "$wpa_wait" -lt 40 ]; do
		wpa_alive=0
		for wpa_pid in $wpa_pids; do
			kill -0 "$wpa_pid" 2>/dev/null && wpa_alive=1
		done
		[ "$wpa_alive" = 0 ] && return 0
		sleep 0.05
		wpa_wait=$((wpa_wait + 1))
	done
	return 1
}

case "$cmd" in
	is-active)
		case "$unit" in
			bluetooth|bluetooth.service) pidof bluetoothd >/dev/null 2>&1; exit $? ;;
			*) exit 3 ;;
		esac
		;;
	start|restart)
		case "$unit" in
			bluetooth|bluetooth.service)
				[ "$cmd" = restart ] && killall bluetoothd 2>/dev/null
				ensure_dbus
				if ! pidof bluetoothd >/dev/null 2>&1; then
					/usr/libexec/bluetooth/bluetoothd </dev/null >/run/bluetoothd.log 2>&1 &
				fi
				n=0
				while ! pidof bluetoothd >/dev/null 2>&1 && [ "$n" -lt 10 ]; do
					sleep 1; n=$((n + 1))
				done
				pidof bluetoothd >/dev/null 2>&1
				exit $?
				;;
			*) exit 0 ;;
		esac
		;;
	stop)
		case "$unit" in
			wpa_supplicant|wpa_supplicant.service|wpa_supplicant@*.service)
				stop_supplicant; exit $? ;;
			bluetooth|bluetooth.service) killall bluetoothd 2>/dev/null; exit 0 ;;
			*) exit 0 ;;
		esac
		;;
	*) exit 0 ;;
esac
