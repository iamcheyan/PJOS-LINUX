#!/bin/sh
# One-time migrations delivered inside an ordinary rootfs update. No updater
# format change is needed. The caller does not execute us after completion.
# Two steps: the boot pair (below) and then this model's native loader.
# Shared boot sectors are not A/B protected: uninterrupted power is required.
#
# Installs the "fast" boot pair (TOC1 package + Android boot image) over either
# audited predecessor, then turns off boot0's serial output:
#   original  uncompressed kernel. Boots only as a matched pair.
#   gzip      the first migration (boot-gzip-v1). A gzip half and a fast half
#             boot together either way round, so every step from here boots.
#   fast      gzip kernel, empty ramdisk, quiet U-Boot and kernel.
# The running kernel is byte-identical under all three: nothing restarts, and
# the new pair takes effect at the next ordinary boot.
set -eu
ROOT=${BASEOS_BOOT_TEST_ROOT:-}
if [ -n "$ROOT" ]; then
	[ "${BASEOS_BOOT_TESTING:-}" = 1 ] && [ -f "$ROOT/.boot-migration-test" ] || exit 1
fi
# With no argument both steps run, each in its own shell: first the boot pair
# ("pair", below), then the native loader ("native"). A nonzero status from
# either means a boot area may be unverified, and stops the rest.
case "${1:-}" in
'')
	/bin/sh "$0" pair || exit $?
	exec /bin/sh "$0" native ;;
pair|native) ;;
*) exit 2 ;;
esac

# The native step installs this model's native loader from the running rootfs:
#   capsule   128 KiB at sector 16. BootROM runs it; it starts the native SPL
#             while the RTC pair GP14/GP15 is zero and the embedded stock
#             boot0 whenever the pair is nonzero.
#   firmware  monitor, loader and trees at boot partition + 40 MiB.
#   image     kernel image the loader unpacks, at boot partition + 48 MiB.
#   TOC       stock U-Boot package without its boot0 rewrite, at the package
#             sector; with the 1.4.0 image at the start of the boot partition
#             it is the stock fallback.
# Order: hold the stock latch (pair nonzero), write firmware, image and TOC,
# then the capsule body and last its header, read everything back, and only
# then clear exactly the pair it holds. A reset at any point before the clear
# starts stock: a nonzero pair selects it, and a header whose checksum does not
# cover the body sends BootROM to the stock copy at the secondary sector. Any
# failure before completion keeps the latch: the device keeps starting stock.
# It writes only from stock Linux or a native boot of this same loader, never
# while a computer owns USB storage, and keeps the first copy of every area it
# replaces on userdata.
native_step() {
	NATIVE="$ROOT/usr/share/baseos/native"
	[ -f "$NATIVE/manifest" ] || exit 0
	NSTATE="$ROOT/data/boot-native-v1"
	ASSETS="$ROOT/usr/share/baseos/boot-gzip"
	DISK="$ROOT/dev/mmcblk0"
	BOOT="$ROOT/dev/mmcblk0p4"
	HEALTH="$ROOT/usr/sbin/native-health"
	RUNNING="$ROOT/sys/firmware/devicetree/base/chosen/baseos,native-boot"
	[ ! -s "$ROOT/run/usb-storage-device" ] || exit 0
	if [ -z "$ROOT" ] && ! awk '
	  $1 == "/dev/mmcblk0p6" && $2 == "/data" && $3 == "ext4" &&
	  ("," $4 ",") ~ /,rw,/ { persistent = 1 }
	  END { exit !persistent }
	' /proc/mounts; then
		exit 0
	fi
	. "$NATIVE/manifest"
	case "${NATIVE_GENERATION:-}" in *[!0-9a-f]*|'') exit 0 ;; esac
	[ "${#NATIVE_GENERATION}" -eq 64 ] || exit 0
	DONE="$NSTATE/done-$NATIVE_GENERATION"
	[ ! -e "$DONE" ] || exit 0
	if ! mkdir -p "$NSTATE" 2>/dev/null || ! { printf '' >> "$NSTATE/install.log"; } 2>/dev/null; then
		exit 0
	fi
	exec 3>>"$NSTATE/install.log"
	WORK=
	unverified=0
	nlog() { { printf '%s\n' "native: $*" >&3; } 2>/dev/null || :; }
	# nresult KIND TEXT: the outcome of this run in one line. It goes to
	# /run for this boot's loader line, and, unless it is a plain wait, to the
	# boot log frontend-session passes in BASEOS_BOOT_LOG. KIND is installed,
	# in-place, failed, start-failed, skipped, gave-up or deferred.
	defer_kind=deferred attempt_number=
	nresult() {
		result_kind=$1
		shift
		{ printf '%s %s\n' "$result_kind" "$*" > "$ROOT/run/baseos-native-result"; } 2>/dev/null || :
		[ "$result_kind" != deferred ] && [ -n "${BASEOS_BOOT_LOG:-}" ] || return 0
		[ ! -s "$ROOT/run/usb-storage-device" ] || return 0
		up=
		{ read -r up _ < /proc/uptime; } 2>/dev/null || up=
		{ printf '%s Fast loader install: %s\n' "${up:-0}" "$*" >> "$BASEOS_BOOT_LOG"; } 2>/dev/null || :
	}
	nsplash() {
		[ ! -x "$ROOT/usr/bin/baseos-splash" ] || "$ROOT/usr/bin/baseos-splash" --important -1 "$*" 2>/dev/null || :
	}
	nfinish() {
		if [ "$unverified" = 1 ]; then
			nlog "the stock U-Boot package is unverified; its previous contents are kept in $WORK"
			nsplash 'BOOT UPDATE FAILED: KEEP POWER ON'
			exit 1
		fi
		[ -z "$WORK" ] || rm -rf "$WORK"
		exit 0
	}
	trap nfinish EXIT
	trap 'exit 0' HUP INT TERM
	# done RESULT: never again for this generation.
	done_with() {
		printf '%s\n' "$1" > "$DONE.tmp" && sync && mv "$DONE.tmp" "$DONE" && sync
		nlog "$1"
	}
	ndefer() {
		nlog "deferred; $*"
		if [ "$defer_kind" = failed ]; then
			nresult failed "$*${attempt_number:+ (try $attempt_number of 3)}; the stock loader stays in use and the next start tries again"
		else
			nresult deferred "$*"
		fi
		exit 0
	}
	nskip() { done_with "skipped: $*"; nresult skipped "not possible on this card: $*"; exit 0; }
	nsha() { sha256sum "$1" 2>&3 | cut -d ' ' -f 1; }
	nmatches() { [ "${#2}" -eq 64 ] && [ "$(nsha "$1")" = "$2" ]; }
	# read_at DEVICE OFFSET BYTES FILE; write_at DEVICE OFFSET FILE. Direct I/O
	# from a 1 MiB buffer, whole sectors only: the card's bytes, not the cache's,
	# and no read-modify-write of a neighbouring sector.
	read_at() {
		dd if="$1" of="$4" bs=1M skip="$2" count="$3" iflag=direct,skip_bytes,count_bytes status=none 2>&3
	}
	write_at() {
		dd if="$3" of="$1" bs=1M seek="$2" oflag=direct,seek_bytes conv=notrunc,fsync status=none 2>&3
	}
	# is_at DEVICE OFFSET BYTES SHA256
	is_at() { read_at "$1" "$2" "$3" "$WORK/readback" && nmatches "$WORK/readback" "$4"; }
	# put DEVICE OFFSET FILE BYTES SHA256 NAME: write, then judge by readback.
	put() {
		nlog "writing $6"
		if write_at "$1" "$2" "$3" && is_at "$1" "$2" "$4" "$5"; then return 0; fi
		nlog "$6 did not read back; writing it once more"
		write_at "$1" "$2" "$3" && is_at "$1" "$2" "$4" "$5"
	}
	latch() { "$HEALTH" --stock-latch 2>&3 | { read -r _ _ state && printf '%s' "$state"; }; }
	usb_free() { [ ! -s "$ROOT/run/usb-storage-device" ]; }
	# A stock boot0: magic, length, the model's body and a checksum that
	# reproduces (sum of words with word 3 counted as the stamp).
	stock_boot0() {
		[ "$(od -An -tx1 -j4 -N8 "$1" 2>&3 | tr -d ' \n')" = 65474f4e2e425430 ] || return 1
		[ "$(od -An -tu4 -j16 -N4 "$1" 2>&3 | tr -d ' ')" = 65536 ] || return 1
		[ "$(wc -c < "$1")" = 65536 ] || return 1
		[ "$(tail -c +513 "$1" | sha256sum | cut -d ' ' -f 1)" = "$BOOT_BOOT0_BODY_SHA256" ] || return 1
		od -An -v -tu4 "$1" 2>&3 | awk '
			{ for (i = 1; i <= NF; i++) { if (n == 3) stored = $i; else total += $i; n++ } }
			END { exit !(n == 16384 && (total + 1594518585) % 4294967296 == stored) }'
	}
	# An earlier BaseOS capsule: 128 KiB eGON image embedding this model's stock
	# boot0 body at 4 KiB. Only its checksum-free shape is judged; it is replaced.
	old_capsule() {
		[ "$(od -An -tx1 -j4 -N8 "$1" 2>&3 | tr -d ' \n')" = 65474f4e2e425430 ] || return 1
		[ "$(od -An -tu4 -j16 -N4 "$1" 2>&3 | tr -d ' ')" = 131072 ] || return 1
		[ "$(dd if="$1" bs=512 skip=9 count=127 2>/dev/null | sha256sum | cut -d ' ' -f 1)" = "$BOOT_BOOT0_BODY_SHA256" ]
	}

	. "$ASSETS/manifest"
	. "$ROOT/etc/baseos-release"
	[ "${BASEOS_TARGET:-}" = "${NATIVE_TARGET:-unset}" ] || nskip 'target mismatch'
	for key in CAPSULE_SECTOR CAPSULE_SIZE SECONDARY_SECTOR FIRMWARE_OFFSET FIRMWARE_SIZE IMAGE_OFFSET \
		IMAGE_SIZE TOC_SECTOR TOC_SIZE; do
		eval "value=\${NATIVE_$key:-}"
		case "$value" in ''|*[!0-9]*|0?*) ndefer "manifest has no usable NATIVE_$key" ;; esac
	done
	for key in BOOT_START BOOT_SECTORS BOOT_IMAGE_SIZE PACKAGE_OFFSET PACKAGE_SIZE; do
		eval "value=\${BOOT_$key:-}"
		case "$value" in ''|*[!0-9]*|0?*) ndefer "boot manifest has no usable BOOT_$key" ;; esac
	done
	for value in "$NATIVE_CAPSULE_SHA256" "$NATIVE_FIRMWARE_SHA256" "$NATIVE_IMAGE_SHA256" \
		"$NATIVE_TOC_SHA256" \
		"${BOOT_BOOT0_BODY_SHA256:-}" "${BOOT_BOOT_IMAGE_SHA256:-}" "${BOOT_PACKAGE_SHA256:-}"; do
		case "$value" in *[!0-9a-f]*) value= ;; esac
		[ "${#value}" -eq 64 ] || ndefer 'manifest hashes are malformed'
	done
	capsule_at=$((NATIVE_CAPSULE_SECTOR * 512)) secondary_at=$((NATIVE_SECONDARY_SECTOR * 512))
	toc_at=$((NATIVE_TOC_SECTOR * 512)) partition_bytes=$((BOOT_BOOT_SECTORS * 512))
	# The layout must be the one the loader and BootROM expect, and must keep
	# every area apart: the stock image stays usable as the fallback.
	if [ "$NATIVE_CAPSULE_SIZE" -ne 131072 ] || [ $((capsule_at + NATIVE_CAPSULE_SIZE)) -gt "$secondary_at" ] \
		|| [ $((secondary_at + 65536)) -gt "$toc_at" ] || [ "$toc_at" -ne "$BOOT_PACKAGE_OFFSET" ] \
		|| [ "$NATIVE_TOC_SIZE" -ne "$BOOT_PACKAGE_SIZE" ] \
		|| [ "$BOOT_BOOT_IMAGE_SIZE" -gt "$NATIVE_FIRMWARE_OFFSET" ] \
		|| [ $((NATIVE_FIRMWARE_OFFSET + NATIVE_FIRMWARE_SIZE)) -gt "$NATIVE_IMAGE_OFFSET" ] \
		|| [ $((NATIVE_IMAGE_OFFSET + NATIVE_IMAGE_SIZE)) -gt "$partition_bytes" ]; then
		nskip 'native layout does not fit this card'
	fi
	for size in "$NATIVE_FIRMWARE_SIZE" "$NATIVE_IMAGE_SIZE" "$NATIVE_TOC_SIZE" "$capsule_at" \
		"$NATIVE_FIRMWARE_OFFSET" "$NATIVE_IMAGE_OFFSET"; do
		[ $((size % 512)) -eq 0 ] || nskip 'native layout is not sector aligned'
	done
	installed=$(od -An -v -tx1 "$ROOT/etc/baseos/native-generation" 2>/dev/null | tr -d ' \n')
	[ "$installed" = "$NATIVE_GENERATION" ] || ndefer 'installed generation differs from the native files'
	[ -x "$HEALTH" ] || ndefer 'native-health is unavailable'
	if [ -z "$ROOT" ] && { [ ! -b "$DISK" ] || [ ! -b "$BOOT" ]; }; then ndefer 'boot block device unavailable'; fi
	if [ "$(cat "$ROOT/sys/class/block/mmcblk0p4/start" 2>/dev/null)" != "$BOOT_BOOT_START" ] \
		|| [ "$(cat "$ROOT/sys/class/block/mmcblk0p4/size" 2>/dev/null)" != "$BOOT_BOOT_SECTORS" ]; then
		nskip 'unrecognized boot partition geometry'
	fi
	# The boot pair step decides first; it may still be waiting for power.
	[ -e "$ROOT/data/boot-pair-v2/complete" ] || ndefer 'the boot pair step has not finished'
	running=
	if [ -e "$RUNNING" ] || [ -L "$RUNNING" ]; then
		running=$(od -An -v -tx1 "$RUNNING" 2>/dev/null | tr -d ' \n')
		# Health refuses another generation before startup gets here.
		[ "$running" = "$NATIVE_GENERATION" ] || ndefer 'running a different native loader'
	fi
	# No battery check: the install takes a few seconds. Writes happen only
	# while the stock latch is held, and a restart then starts stock: the
	# firmware and kernel image sit where stock never reads, and the capsule
	# body goes in before its header, so a half-written capsule fails BootROM's
	# checksum and BootROM takes the stock copy at the secondary sector. The
	# one exception is the U-Boot package, when it has to change (cards coming
	# from 1.4.0 or older): it is the stock path's only copy, and power lost in
	# the fraction of a second it takes to write leaves stock unable to start.
	# Its previous contents stay in boot-native-v1/toc-before.bin.
	nmatches "$NATIVE/capsule.bin" "$NATIVE_CAPSULE_SHA256" && nmatches "$NATIVE/firmware.bin" "$NATIVE_FIRMWARE_SHA256" \
		&& nmatches "$NATIVE/image.bin" "$NATIVE_IMAGE_SHA256" && nmatches "$NATIVE/recovery-toc.bin" "$NATIVE_TOC_SHA256" \
		&& [ "$(wc -c < "$NATIVE/capsule.bin")" -eq "$NATIVE_CAPSULE_SIZE" ] \
		&& [ "$(wc -c < "$NATIVE/firmware.bin")" -eq "$NATIVE_FIRMWARE_SIZE" ] \
		&& [ "$(wc -c < "$NATIVE/image.bin")" -eq "$NATIVE_IMAGE_SIZE" ] \
		&& [ "$(wc -c < "$NATIVE/recovery-toc.bin")" -eq "$NATIVE_TOC_SIZE" ] \
		|| nskip 'native files failed verification'

	WORK=$(mktemp -d "$ROOT/tmp/boot-native.XXXXXX")
	read_at "$DISK" "$capsule_at" "$NATIVE_CAPSULE_SIZE" "$WORK/primary.cur" \
		&& read_at "$DISK" "$secondary_at" 65536 "$WORK/secondary.cur" \
		&& read_at "$DISK" "$toc_at" "$NATIVE_TOC_SIZE" "$WORK/toc.cur" \
		&& read_at "$BOOT" 0 "$BOOT_BOOT_IMAGE_SIZE" "$WORK/stock-image.cur" \
		&& read_at "$BOOT" "$NATIVE_FIRMWARE_OFFSET" "$NATIVE_FIRMWARE_SIZE" "$WORK/firmware.cur" \
		&& read_at "$BOOT" "$NATIVE_IMAGE_OFFSET" "$NATIVE_IMAGE_SIZE" "$WORK/image.cur" \
		|| ndefer 'cannot read the boot areas'
	# An install this step started and still holds the latch for may have
	# stopped part way: whatever it left in sector 16 or the package is its own.
	resuming=0
	[ ! -r "$NSTATE/latch" ] || { read -r owner < "$NSTATE/latch" && [ "$owner" = "$NATIVE_GENERATION" ] && resuming=1; } || :
	head -c 65536 "$WORK/primary.cur" > "$WORK/primary-stock.cur"
	if nmatches "$WORK/primary.cur" "$NATIVE_CAPSULE_SHA256"; then primary=this
	elif stock_boot0 "$WORK/primary-stock.cur"; then primary=stock
	elif old_capsule "$WORK/primary.cur"; then primary=earlier
	elif [ "$resuming" = 1 ]; then primary=partial
	else nskip 'sector 16 holds neither stock boot0 nor a BaseOS capsule'
	fi
	stock_boot0 "$WORK/secondary.cur" || nskip 'the secondary sector holds no stock boot0 to fall back on'
	nmatches "$WORK/stock-image.cur" "$BOOT_BOOT_IMAGE_SHA256" || nskip 'the stock fallback image is not the 1.4.0 image'
	toc_sha=$(nsha "$WORK/toc.cur")
	case " $NATIVE_TOC_SHA256 " in *" $toc_sha "*) toc=this ;; *)
		case " $BOOT_PACKAGE_SHA256 ${NATIVE_PREVIOUS_TOC_SHA256:-} " in
		*" $toc_sha "*) toc=earlier ;;
		*) [ "$resuming" = 1 ] || nskip 'the U-Boot package is not one this system installed'
			toc=partial ;;
		esac ;;
	esac
	nmatches "$WORK/firmware.cur" "$NATIVE_FIRMWARE_SHA256" && firmware=this || firmware=other
	nmatches "$WORK/image.cur" "$NATIVE_IMAGE_SHA256" && image=this || image=other
	nlog "found primary $primary, package $toc, firmware $firmware, image $image, pair $(latch)"

	if [ "$primary/$toc/$firmware/$image" = this/this/this/this ]; then
		state=$(latch)
		if [ "$state" = held ] && [ ! -e "$NSTATE/latch" ]; then
			# This loader's own attempt failed: its SPL latched the pair and
			# the watchdog chose stock. Retrying would only fail again.
			done_with 'native boot failed health; the device stays on stock startup'
			nresult start-failed "the files are in place, but the fast loader's start failed; this version stays on the stock loader"
			exit 0
		fi
		if [ "$state" != idle ]; then
			usb_free || ndefer 'a computer owns USB storage'
			printf '%s\n' "$NATIVE_GENERATION" > "$NSTATE/latch" && sync
			defer_kind=failed
			"$HEALTH" --hold-stock >&3 2>&3 && [ "$(latch)" = held ] \
				&& "$HEALTH" --release-stock >&3 2>&3 && [ "$(latch)" = idle ] \
				|| ndefer 'could not clear the stock latch'
			defer_kind=deferred
			rm -f "$NSTATE/latch" && sync
			nlog 'stock latch cleared'
		fi
		done_with "installed${running:+; running}"
		nresult in-place "the files were already in place${running:+ and running}"
		exit 0
	fi
	[ -z "$running" ] || ndefer 'native files differ while their own loader is running'

	attempts=0
	[ ! -r "$NSTATE/attempts-$NATIVE_GENERATION" ] || read -r attempts < "$NSTATE/attempts-$NATIVE_GENERATION" || attempts=0
	case "$attempts" in ''|*[!0-9]*) attempts=0 ;; esac
	if [ "$attempts" -ge 3 ]; then
		done_with 'gave up after 3 failed attempts; the device stays on stock startup'
		nresult gave-up "gave up after 3 failed tries; this version stays on the stock loader"
		exit 0
	fi
	# First copies only: the areas as they were before any native install.
	need_kb=$(( (NATIVE_CAPSULE_SIZE + 65536 + NATIVE_TOC_SIZE + NATIVE_FIRMWARE_SIZE + NATIVE_IMAGE_SIZE) / 1024 + 4096 ))
	free_kb=$(df -Pk "$NSTATE" | awk 'END { print $4 }')
	case "$free_kb" in ''|*[!0-9]*) ndefer 'cannot determine backup space' ;; esac
	[ "$free_kb" -ge "$need_kb" ] || ndefer 'insufficient userdata space for backups'
	for area in primary secondary toc firmware image; do
		[ ! -e "$NSTATE/$area-before.bin" ] || continue
		cp "$WORK/$area.cur" "$NSTATE/$area-before.bin.tmp" && sync \
			&& cmp -s "$WORK/$area.cur" "$NSTATE/$area-before.bin.tmp" \
			&& mv "$NSTATE/$area-before.bin.tmp" "$NSTATE/$area-before.bin" && sync \
			|| ndefer 'could not save and verify boot backups'
	done
	printf '%s\n' $((attempts + 1)) > "$NSTATE/attempts-$NATIVE_GENERATION" && sync
	attempt_number=$((attempts + 1))
	usb_free || ndefer 'a computer owns USB storage'
	defer_kind=failed
	nsplash 'INSTALLING FAST STARTUP: KEEP POWER ON'
	trap '' HUP INT TERM
	printf '%s\n' "$NATIVE_GENERATION" > "$NSTATE/latch" && sync
	if ! "$HEALTH" --hold-stock >&3 2>&3 || [ "$(latch)" != held ]; then
		ndefer 'could not hold the stock latch; nothing was written'
	fi
	nlog "stock latch held ($NATIVE_COOKIE 42535031)"
	head -c 512 "$NATIVE/capsule.bin" > "$WORK/capsule-header.bin"
	tail -c +513 "$NATIVE/capsule.bin" > "$WORK/capsule-body.bin"
	body_sha=$(nsha "$WORK/capsule-body.bin")
	failed=
	if [ "$firmware" != this ] && ! put "$BOOT" "$NATIVE_FIRMWARE_OFFSET" "$NATIVE/firmware.bin" \
		"$NATIVE_FIRMWARE_SIZE" "$NATIVE_FIRMWARE_SHA256" firmware; then failed=firmware
	elif [ "$image" != this ] && ! put "$BOOT" "$NATIVE_IMAGE_OFFSET" "$NATIVE/image.bin" \
		"$NATIVE_IMAGE_SIZE" "$NATIVE_IMAGE_SHA256" 'kernel image'; then failed='kernel image'
	elif [ "$toc" != this ]; then
		# The package is the stock fallback's only copy: never leave it unverified.
		unverified=1
		if put "$DISK" "$toc_at" "$NATIVE/recovery-toc.bin" "$NATIVE_TOC_SIZE" "$NATIVE_TOC_SHA256" 'U-Boot package'; then
			unverified=0
		else
			failed='U-Boot package'
			# A package this step left half written is no copy to go back to.
			[ "$toc" != partial ] || exit 1
			nlog 'restoring the previous U-Boot package'
			write_at "$DISK" "$toc_at" "$WORK/toc.cur" || :
			is_at "$DISK" "$toc_at" "$NATIVE_TOC_SIZE" "$toc_sha" || exit 1
			unverified=0
		fi
	fi
	if [ -z "$failed" ]; then
		if ! usb_free; then failed='USB storage started'
		elif [ "$(latch)" != held ]; then failed='the stock latch changed'
		elif ! is_at "$DISK" "$secondary_at" 65536 "$(nsha "$WORK/secondary.cur")"; then failed='secondary changed'
		elif ! put "$DISK" $((capsule_at + 512)) "$WORK/capsule-body.bin" $((NATIVE_CAPSULE_SIZE - 512)) \
			"$body_sha" 'capsule body'; then failed='capsule body'
		elif ! put "$DISK" "$capsule_at" "$WORK/capsule-header.bin" 512 \
			"$(nsha "$WORK/capsule-header.bin")" 'capsule header'; then failed='capsule header'
		fi
	fi
	if [ -z "$failed" ]; then
		for check in "$DISK $capsule_at $NATIVE_CAPSULE_SIZE $NATIVE_CAPSULE_SHA256 capsule" \
			"$DISK $secondary_at 65536 $(nsha "$WORK/secondary.cur") secondary" \
			"$DISK $toc_at $NATIVE_TOC_SIZE $NATIVE_TOC_SHA256 package" \
			"$BOOT 0 $BOOT_BOOT_IMAGE_SIZE $BOOT_BOOT_IMAGE_SHA256 stock-image" \
			"$BOOT $NATIVE_FIRMWARE_OFFSET $NATIVE_FIRMWARE_SIZE $NATIVE_FIRMWARE_SHA256 firmware" \
			"$BOOT $NATIVE_IMAGE_OFFSET $NATIVE_IMAGE_SIZE $NATIVE_IMAGE_SHA256 image"; do
			set -- $check
			is_at "$1" "$2" "$3" "$4" || { failed="final readback of $5"; break; }
		done
	fi
	if [ -n "$failed" ]; then
		nlog "FAILED at $failed; keeping the stock latch, so the device keeps starting stock"
		nresult failed "failed at $failed (try $attempt_number of 3; the stock loader stays in use and the next start tries again)"
		exit 0
	fi
	if ! "$HEALTH" --release-stock >&3 2>&3 || [ "$(latch)" != idle ]; then
		nlog 'everything verified, but the stock latch did not clear; stock startup continues'
		nresult failed "written and checked, but the stock latch did not clear (try $attempt_number of 3)"
		exit 0
	fi
	rm -f "$NSTATE/latch" && sync
	nlog 'stock latch cleared; the native loader starts at the next boot'
	done_with installed
	nresult installed "installed and checked; it is used from the next start"
	exit 0
}
if [ "$1" = native ]; then
	native_step
	exit 0
fi

# The boot pair step.
STATE="$ROOT/data/boot-pair-v2"
# The first migration's directory is only ever read here: it may hold the
# user's sole durable copy of the original pair.
FIRST="$ROOT/data/boot-gzip-v1"
ASSETS="$ROOT/usr/share/baseos/boot-gzip"
DISK="$ROOT/dev/mmcblk0"
BOOT="$ROOT/dev/mmcblk0p4"
SYS="$ROOT/sys"
[ ! -e "$STATE/complete" ] || exit 0
[ ! -s "$ROOT/run/usb-storage-device" ] || exit 0
[ -f "$ASSETS/manifest" ] || exit 0
# rcS can substitute tmpfs when userdata cannot mount. Backups on that fallback
# would disappear at reboot, so never migrate without the real writable ext4.
if [ -z "$ROOT" ] && ! awk '
  $1 == "/dev/mmcblk0p6" && $2 == "/data" && $3 == "ext4" &&
  ("," $4 ",") ~ /,rw,/ { persistent = 1 }
  END { exit !persistent }
' /proc/mounts; then
	printf '%s\n' 'boot-pair: deferred; persistent writable userdata is unavailable' >&2
	exit 0
fi

# The exit status is a contract: frontend-session halts startup on non-zero,
# which is right only while a boot area has been written but not verified. Any
# other ending, including an unexpected shell error under set -eu or a signal
# before the first write, must be an ordinary exit so the device still starts;
# with no marker a later boot tries again. An unverified ending keeps the
# working copies in /tmp, where ADB can reach them while power stays on.
WORK=
unverified=0
log() { { printf '%s\n' "boot-pair: $*" >&3; } 2>/dev/null || :; }
splash() {
	if [ -x "$ROOT/usr/bin/baseos-splash" ]; then
		"$ROOT/usr/bin/baseos-splash" --important -1 "$*" 2>/dev/null || :
	fi
}
finish() {
	if [ "$unverified" = 1 ]; then
		log "boot areas are unverified; their previous contents are kept in $WORK"
		splash 'BOOT UPDATE FAILED: KEEP POWER ON'
		exit 1
	fi
	[ -z "$WORK" ] || rm -rf "$WORK"
	exit 0
}
trap finish EXIT
trap 'exit 0' HUP INT TERM

# One log descriptor, opened once. A redirection that cannot be opened makes
# its command fail, and no write or readback below may fail for want of a log.
if ! mkdir -p "$STATE" 2>/dev/null \
	|| ! { printf '' >> "$STATE/migration.log"; } 2>/dev/null; then
	printf '%s\n' 'boot-pair: deferred; cannot record progress on userdata' >&2
	exit 0
fi
exec 3>>"$STATE/migration.log"
complete() {
	printf '%s\n' "$1" > "$STATE/complete.tmp" || return 1
	sync
	mv "$STATE/complete.tmp" "$STATE/complete" || return 1
	sync
}
skip() {
	log "$*; preserving the existing boot areas"
	complete "skipped: $*"
}
defer() { log "deferred; $*"; exit 0; }
sha() { sha256sum "$1" 2>&3 | cut -d ' ' -f 1; }
# The length test keeps a hash that could not be computed from ever matching.
matches() { [ "${#2}" -eq 64 ] && [ "$(sha "$1")" = "$2" ]; }

# Both files belong to the verified installed rootfs, not a card manifest.
. "$ASSETS/manifest"
. "$ROOT/etc/baseos-release"
if [ "${BASEOS_TARGET:-}" != "${BOOT_TARGET:-unset}" ]; then skip 'target mismatch'; exit 0; fi
# Every value used below must be present and well formed before it reaches
# arithmetic or a comparison. A manifest from before the fast pair lacks the
# newer keys. Nothing on the card has been judged yet, so leave no marker: a
# rootfs update carrying a complete manifest can still migrate.
for key in PACKAGE_OFFSET PACKAGE_SIZE BOOT_START BOOT_SECTORS BOOT_IMAGE_SIZE \
	GZIP_BOOT_IMAGE_SIZE ORIGINAL_BOOT_IMAGE_SIZE BOOT0_OFFSET BOOT0_SIZE \
	BOOT0_DEBUG_OFFSET BOOT0_BODY_OFFSET; do
	eval "value=\${BOOT_$key:-}"
	case "$value" in ''|*[!0-9]*|0?*) defer "manifest has no usable BOOT_$key" ;; esac
done
for key in PACKAGE_SHA256 BOOT_IMAGE_SHA256 GZIP_PACKAGE_SHA256 GZIP_BOOT_IMAGE_SHA256 \
	ORIGINAL_PACKAGE_SHA256 ORIGINAL_BOOT_IMAGE_SHA256 ORIGINAL_BOOT_SHA256 \
	BOOT0_BODY_SHA256; do
	eval "value=\${BOOT_$key:-}"
	case "$value" in *[!0-9a-f]*) value= ;; esac
	[ "${#value}" -eq 64 ] || defer "manifest has no usable BOOT_$key"
done
# One read long enough for the longest audited image identifies whichever is
# installed. Whole sectors only: see read_direct.
read_bytes=0
for size in "$BOOT_BOOT_IMAGE_SIZE" "$BOOT_GZIP_BOOT_IMAGE_SIZE" "$BOOT_ORIGINAL_BOOT_IMAGE_SIZE"; do
	if [ "$size" -eq 0 ] || [ $((size % 512)) -ne 0 ] \
		|| [ "$size" -gt $((BOOT_BOOT_SECTORS * 512)) ]; then
		defer 'manifest image sizes do not fit the boot partition'
	fi
	[ "$size" -le "$read_bytes" ] || read_bytes=$size
done
if [ "$BOOT_PACKAGE_SIZE" -eq 0 ] || [ $((BOOT_PACKAGE_SIZE % 512)) -ne 0 ] \
	|| [ $((BOOT_PACKAGE_OFFSET % 512)) -ne 0 ]; then
	defer 'manifest boot package is not sector aligned'
fi

if [ -z "$ROOT" ] && { [ ! -b "$DISK" ] || [ ! -b "$BOOT" ]; }; then
	skip 'boot block device unavailable'; exit 0
fi
if [ "$(cat "$SYS/class/block/mmcblk0p4/start")" != "$BOOT_BOOT_START" ] \
	|| [ "$(cat "$SYS/class/block/mmcblk0p4/size")" != "$BOOT_BOOT_SECTORS" ]; then
	skip 'unrecognized boot partition geometry'; exit 0
fi

# Defer a low-battery upgrade; the new rootfs boots from every audited pair.
# A later ordinary boot retries. No network or frontend setup needed.
powered=0
capacity=0
for supply in "$SYS"/class/power_supply/*; do
	[ ! -r "$supply/online" ] || {
		read -r online < "$supply/online" || online=0
		[ "$online" != 1 ] || powered=1
	}
	[ ! -r "$supply/capacity" ] || read -r capacity < "$supply/capacity" || capacity=0
done
case "$capacity" in ''|*[!0-9]*) capacity=0 ;; esac
if [ "$powered" -ne 1 ] && [ "$capacity" -lt 50 ]; then
	defer 'waiting for external power or at least 50% battery'
fi
if ! matches "$ASSETS/boot-package.bin" "$BOOT_PACKAGE_SHA256" \
	|| ! matches "$ASSETS/boot.img" "$BOOT_BOOT_IMAGE_SHA256" \
	|| [ "$(wc -c < "$ASSETS/boot-package.bin")" -ne "$BOOT_PACKAGE_SIZE" ] \
	|| [ "$(wc -c < "$ASSETS/boot.img")" -ne "$BOOT_BOOT_IMAGE_SIZE" ]; then
	skip 'migration assets failed verification'; exit 0
fi

WORK=$(mktemp -d "$ROOT/tmp/boot-pair.XXXXXX")
# read_direct DEVICE OFFSET BYTES FILE: what the card holds, not what the
# kernel remembers writing. BusyBox dd drops O_DIRECT without a word when a
# read is refused, which happens for a buffer below one page (it is then not
# sector aligned) or a length that is not whole sectors. A 1 MiB buffer and the
# sector checks above keep every read here genuinely direct.
read_direct() {
	dd if="$1" of="$4" bs=1M skip="$2" count="$3" iflag=direct,skip_bytes,count_bytes 2>&3
}
# Each write returns dd's status, and conv=fsync makes that include the flush
# to the card. Only the source's own bytes are written: whatever follows the
# image in the partition is left alone.
write_image() { dd if="$1" of="$BOOT" bs=1M conv=notrunc,fsync 2>&3; }
write_package() {
	dd if="$1" of="$DISK" bs=512 seek=$((BOOT_PACKAGE_OFFSET / 512)) conv=notrunc,fsync 2>&3
}
# The boot0 patch must reach the card as one sector and nothing more. A plain
# 512-byte write goes through the block cache, which rewrites the whole 4 KiB
# block around it: seven sectors of boot0's body as well. O_DIRECT from a
# page-aligned buffer sends just the one, so count and seek are in bytes here.
write_boot0_sector() {
	dd if="$1" of="$DISK" bs=1M count=512 seek="$BOOT_BOOT0_OFFSET" \
		iflag=count_bytes oflag=direct,seek_bytes conv=notrunc,fsync 2>&3
}
# Readback tests: is the first $1 bytes of the partition / the package / boot0
# on the card exactly the bytes with this hash?
image_is() { read_direct "$BOOT" 0 "$1" "$WORK/image.readback" && matches "$WORK/image.readback" "$2"; }
package_is() {
	read_direct "$DISK" "$BOOT_PACKAGE_OFFSET" "$BOOT_PACKAGE_SIZE" "$WORK/package.readback" \
		&& matches "$WORK/package.readback" "$1"
}
boot0_is() {
	read_direct "$DISK" "$BOOT_BOOT0_OFFSET" "$BOOT_BOOT0_SIZE" "$WORK/boot0.readback" \
		&& matches "$WORK/boot0.readback" "$1"
}

# Identify the installed pair. U-Boot reads only the bytes the image header
# describes, so an image is recognised by a hash over exactly that many bytes
# from the start of the partition; what lies beyond differs from card to card.
# These two files are also what an in-session rollback puts back.
if ! read_direct "$DISK" "$BOOT_PACKAGE_OFFSET" "$BOOT_PACKAGE_SIZE" "$WORK/package.cur" \
	|| ! read_direct "$BOOT" 0 "$read_bytes" "$WORK/image.cur"; then
	skip 'cannot read the installed boot pair'; exit 0
fi
previous_package=$(sha "$WORK/package.cur")
previous_image=$(sha "$WORK/image.cur")
# A native install keeps the 1.4.0 image and replaces the package with its
# own; the native step owns the boot areas from then on.
if [ -f "$ROOT/usr/share/baseos/native/manifest" ]; then
	NATIVE_TOC_SHA256= NATIVE_PREVIOUS_TOC_SHA256=
	. "$ROOT/usr/share/baseos/native/manifest"
	case " ${NATIVE_TOC_SHA256:-none} ${NATIVE_PREVIOUS_TOC_SHA256:-} " in
	*" $previous_package "*)
		log 'native boot files present; the native step owns the boot areas'
		complete 'native boot files present'
		exit 0 ;;
	esac
fi
case "$previous_package" in
"$BOOT_PACKAGE_SHA256") package_state=fast ;;
"$BOOT_GZIP_PACKAGE_SHA256") package_state=gzip ;;
"$BOOT_ORIGINAL_PACKAGE_SHA256") package_state=original ;;
*) package_state=unknown ;;
esac
image_prefix_is() {
	[ "$(head -c "$1" "$WORK/image.cur" | sha256sum | cut -d ' ' -f 1)" = "$2" ]
}
if image_prefix_is "$BOOT_BOOT_IMAGE_SIZE" "$BOOT_BOOT_IMAGE_SHA256"; then
	image_state=fast image_bytes=$BOOT_BOOT_IMAGE_SIZE image_sha=$BOOT_BOOT_IMAGE_SHA256
elif image_prefix_is "$BOOT_GZIP_BOOT_IMAGE_SIZE" "$BOOT_GZIP_BOOT_IMAGE_SHA256"; then
	image_state=gzip image_bytes=$BOOT_GZIP_BOOT_IMAGE_SIZE image_sha=$BOOT_GZIP_BOOT_IMAGE_SHA256
elif image_prefix_is "$BOOT_ORIGINAL_BOOT_IMAGE_SIZE" "$BOOT_ORIGINAL_BOOT_IMAGE_SHA256"; then
	image_state=original image_bytes=$BOOT_ORIGINAL_BOOT_IMAGE_SIZE
	image_sha=$BOOT_ORIGINAL_BOOT_IMAGE_SHA256
else
	image_state=unknown
fi
# A pair counts only when both halves are recognised. gzip/fast mixtures are
# what an interrupted earlier run of this migration leaves behind; they boot
# and are completed like a gzip pair. An original half beside anything else is
# not a state this system could have booted from, so it is unknown firmware.
case "$package_state/$image_state" in
fast/fast) pair=fast ;;
gzip/gzip|gzip/fast|fast/gzip) pair=gzip ;;
original/original) pair=original ;;
*)
	skip "firmware differs from the audited pairs (package $package_state, image $image_state)"
	exit 0 ;;
esac

# boot0 rewrites its own first sector on the card at every boot (checksum and
# memory-training results), so only the bytes after that sector can be pinned
# by hash. The header is judged by structure: magic, length word and a checksum
# that reproduces. The Allwinner checksum is the 32-bit sum of every
# little-endian word with the stored checksum (word 3) replaced by 0x5F0A6C39.
# 16384 words sum to less than 2^46, so awk's doubles are exact. od prints
# words in the byte order of the machine, which is little-endian on every
# target; anywhere else the checks below fail and boot0 is simply left alone.
# Word 4 is the length; only the first sector's words are kept for lookup.
# Sets boot0_fault (empty when sound), boot0_debug and boot0_sum.
boot0_inspect() {
	boot0_fault= boot0_debug= boot0_sum=
	read -r boot0_words boot0_length boot0_debug boot0_sum boot0_computed <<EOF
$(od -An -v -tu4 "$1" 2>&3 | awk -v debug="$((BOOT_BOOT0_DEBUG_OFFSET / 4))" '
	BEGIN { n = 0 }
	{ for (i = 1; i <= NF; i++) { if (n < 128) word[n] = $i; total += $i; n++ } }
	END {
		printf "%d %.0f %d %.0f %.0f\n", n, word[4], word[debug] % 256, word[3],
			(total - word[3] + 1594518585) % 4294967296
	}')
EOF
	if [ "$boot0_words" != "$((BOOT_BOOT0_SIZE / 4))" ]; then
		boot0_fault='cannot be read in full'
	elif [ "$(od -An -tx1 -j4 -N8 "$1" 2>&3 | tr -d ' \n')" != 65474f4e2e425430 ]; then	# eGON.BT0
		boot0_fault='unexpected magic'
	elif [ "$boot0_length" != "$BOOT_BOOT0_SIZE" ]; then
		boot0_fault='unexpected length'
	elif [ "$(tail -c +$((BOOT_BOOT0_BODY_OFFSET + 1)) "$1" | sha256sum | cut -d ' ' -f 1)" \
		!= "$BOOT_BOOT0_BODY_SHA256" ]; then
		boot0_fault='unexpected contents'
	elif [ "$boot0_sum" != "$boot0_computed" ]; then
		boot0_fault='checksum does not reproduce'
	elif [ "$boot0_debug" != 3 ] && [ "$boot0_debug" != 0 ]; then
		boot0_fault="unexpected debug value $boot0_debug"
	fi
	[ -z "$boot0_fault" ]
}
# Examine boot0 before anything is written. A boot0 that fails any check is
# never touched; the pair is still migrated and the result says why.
boot0_plan=leave boot0_fault= boot0_debug= boot0_sum=
if [ "$BOOT_BOOT0_BODY_OFFSET" -ne 512 ] || [ "$BOOT_BOOT0_DEBUG_OFFSET" -ge 512 ] \
	|| [ $((BOOT_BOOT0_DEBUG_OFFSET % 4)) -ne 0 ] \
	|| [ $((BOOT_BOOT0_OFFSET % 512)) -ne 0 ] || [ $((BOOT_BOOT0_SIZE % 512)) -ne 0 ]; then
	# The patch assumes the debug byte is the low byte of a word inside the
	# one sector boot0 rewrites, and that the pinned body is everything else.
	boot0_fault='manifest describes a layout this patch does not cover'
elif ! read_direct "$DISK" "$BOOT_BOOT0_OFFSET" "$BOOT_BOOT0_SIZE" "$WORK/boot0.cur"; then
	boot0_fault='cannot be read'
elif boot0_inspect "$WORK/boot0.cur"; then
	if [ "$boot0_debug" = 0 ]; then boot0_plan=quiet; else boot0_plan=patch; fi
fi
boot0_note=
[ "$boot0_plan" != leave ] || boot0_note="boot0 left unchanged: $boot0_fault"
log "found package $package_state, image $image_state, ${boot0_note:-boot0 debug $boot0_debug}"

# A durable recovery copy must be on userdata before either shared boot
# component changes. An existing backup that is not exactly what its name says
# is never overwritten. save FILE BYTES NAME HASH keeps the first BYTES of FILE.
save() {
	if [ -e "$STATE/$3" ]; then
		matches "$STATE/$3" "$4"
		return
	fi
	dd if="$1" of="$STATE/$3.tmp" bs=1M count="$2" iflag=count_bytes conv=fsync 2>&3 || return 1
	matches "$STATE/$3.tmp" "$4" || return 1
	mv "$STATE/$3.tmp" "$STATE/$3" || return 1
	sync
}
install_pair() {
	if [ "$image_state" != fast ]; then
		write_image "$ASSETS/boot.img" || return 1
		# Beside a gzip or fast package this image already boots, so prove it
		# before touching the package, which has no second copy on the card.
		# Beside the original package it does not boot: go straight on and
		# close that window, as the first migration did.
		if [ "$pair" != original ] \
			&& ! image_is "$BOOT_BOOT_IMAGE_SIZE" "$BOOT_BOOT_IMAGE_SHA256"; then
			return 1
		fi
	fi
	if [ "$package_state" != fast ]; then
		write_package "$ASSETS/boot-package.bin" || return 1
	fi
	sync
	image_is "$BOOT_BOOT_IMAGE_SIZE" "$BOOT_BOOT_IMAGE_SHA256" && package_is "$BOOT_PACKAGE_SHA256"
}
restore_pair() {
	# Judge by direct readback, not by which write reported an error, and put
	# back only what no longer matches: a component that was never changed is
	# not put at risk a second time. Package first: it is the quick write, and
	# beside a gzip package either image boots.
	package_is "$previous_package" || write_package "$WORK/package.cur" || :
	image_is "$read_bytes" "$previous_image" || write_image "$WORK/image.cur" || :
	sync
	package_is "$previous_package" && image_is "$read_bytes" "$previous_image"
}
# boot0 has no second copy on the card and no fixed image to compare with.
# Returns 0 when it is patched and verified, 1 when it is verified to be
# exactly as found (boot0_fault says why), 2 when its state is unknown.
patch_boot0() {
	# Build the sector from a fresh read, not from the one taken before the
	# pair was written, and repeat every check on it.
	if ! read_direct "$DISK" "$BOOT_BOOT0_OFFSET" "$BOOT_BOOT0_SIZE" "$WORK/boot0.cur"; then
		boot0_fault='cannot be read'
		return 1
	fi
	boot0_inspect "$WORK/boot0.cur" || return 1
	[ "$boot0_debug" != 0 ] || return 0
	boot0_before=$(sha "$WORK/boot0.cur")
	old_debug=$boot0_debug old_sum=$boot0_sum
	# The debug byte is the low byte of a little-endian word, so clearing it
	# lowers the 32-bit sum by exactly its value. Adding 2^32 first keeps a
	# checksum smaller than that value from going negative.
	new_sum=$(((old_sum + 4294967296 - old_debug) % 4294967296))
	boot0_fault='a patched header could not be prepared'
	cp "$WORK/boot0.cur" "$WORK/boot0.new" || return 1
	printf "$(printf '\\%03o\\%03o\\%03o\\%03o' $((new_sum & 255)) $((new_sum >> 8 & 255)) \
		$((new_sum >> 16 & 255)) $((new_sum >> 24 & 255)))" \
		| dd of="$WORK/boot0.new" bs=1 seek=12 conv=notrunc 2>&3 || return 1
	printf '\000' \
		| dd of="$WORK/boot0.new" bs=1 seek="$BOOT_BOOT0_DEBUG_OFFSET" conv=notrunc 2>&3 || return 1
	# Prove the candidate with the full checksum, not the shortcut above,
	# before any of it goes near the card.
	if ! boot0_inspect "$WORK/boot0.new" || [ "$boot0_debug" != 0 ]; then
		boot0_fault='the patched header failed its own checks'
		return 1
	fi
	boot0_after=$(sha "$WORK/boot0.new")
	trap '' HUP INT TERM
	unverified=1
	log "boot0: debug $old_debug -> 0, checksum $old_sum -> $new_sum; writing one sector"
	# Only the first sector of the candidate is written: the one sector boot0
	# itself rewrites. Then all of boot0 is read back and judged again.
	if write_boot0_sector "$WORK/boot0.new" && boot0_is "$boot0_after" \
		&& boot0_inspect "$WORK/boot0.readback" && [ "$boot0_debug" = 0 ]; then
		unverified=0
		return 0
	fi
	log 'boot0 patch failed verification; restoring the previous sector'
	boot0_is "$boot0_before" || write_boot0_sector "$WORK/boot0.cur" || :
	boot0_is "$boot0_before" || return 2
	unverified=0
	boot0_fault='the patch could not be verified and was undone'
	return 1
}

if [ "$pair" = fast ] && [ "$boot0_plan" != patch ]; then
	log 'fast boot pair already installed; nothing to write'
	complete "already-installed${boot0_note:+; $boot0_note}"
	exit 0
fi
splash 'OPTIMISING STARTUP: KEEP POWER ON'
result=already-installed
if [ "$pair" != fast ]; then
	# The first migration's copy of the original pair is recovery enough while
	# intact: written back together, its halves boot. It is not duplicated.
	# Otherwise save the installed pair itself, image bytes only.
	if [ -f "$FIRST/package-original.bin" ] && [ -f "$FIRST/boot-original.bin" ] \
		&& matches "$FIRST/package-original.bin" "$BOOT_ORIGINAL_PACKAGE_SHA256" \
		&& matches "$FIRST/boot-original.bin" "$BOOT_ORIGINAL_BOOT_SHA256"; then
		log 'recovery copy: the original pair saved by the first migration is intact'
	else
		package_copy=package-$package_state.bin
		image_copy=boot-image-$image_state.bin
		need_kb=4096
		[ -e "$STATE/$package_copy" ] || need_kb=$((need_kb + BOOT_PACKAGE_SIZE / 1024))
		[ -e "$STATE/$image_copy" ] || need_kb=$((need_kb + image_bytes / 1024))
		free_kb=$(df -Pk "$STATE" | awk 'END { print $4 }')
		case "$free_kb" in ''|*[!0-9]*) skip 'cannot determine backup space'; exit 0 ;; esac
		if [ "$free_kb" -lt "$need_kb" ]; then skip 'insufficient userdata space for backups'; exit 0; fi
		if ! save "$WORK/package.cur" "$BOOT_PACKAGE_SIZE" "$package_copy" "$previous_package" \
			|| ! save "$WORK/image.cur" "$image_bytes" "$image_copy" "$image_sha"; then
			skip 'could not save and verify boot backups'; exit 0
		fi
		log "recovery copy: saved $package_copy and $image_copy"
	fi
	# Do not allow a frontend/process signal to interrupt the writes. This
	# cannot protect against loss of power; the backups support offline recovery.
	trap '' HUP INT TERM
	unverified=1
	log "backups complete; installing the fast pair over the $pair pair"
	if install_pair; then
		unverified=0
		log 'fast pair verified by direct readback'
		result=installed
	else
		log 'installation failed; restoring the previous boot pair'
		if restore_pair; then
			unverified=0
			log 'previous pair restored and verified; continuing normal startup'
			complete rolled-back
			exit 0
		fi
		log 'RESTORE FAILED: keep power on; ADB remains available; do not reboot'
		exit 1
	fi
fi
# boot0 goes last, once the pair it starts is proven.
if [ "$boot0_plan" = patch ]; then
	status=0
	patch_boot0 || status=$?
	case "$status" in
	0)
		log 'boot0 patch verified by direct readback'
		result=installed ;;
	1)
		boot0_note="boot0 left unchanged: $boot0_fault"
		log "$boot0_note" ;;
	*)
		log 'BOOT0 RESTORE FAILED: keep power on; ADB remains available; do not reboot'
		exit 1 ;;
	esac
fi
complete "$result${boot0_note:+; $boot0_note}"
# The already-running kernel is byte-identical to the one in the fast image.
# Continue this session; the next ordinary boot uses the optimised pair.
# No migration-only restart, shutdown race or extra trial boot is needed.
log 'continuing startup; changes take effect at the next ordinary boot'
exit 0
