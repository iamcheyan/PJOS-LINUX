#!/bin/sh
# Save session state before an intentional stop.
#
# Writes /storage/.config/pocketjs/resume.state:
#   kind=rom
#   target=/storage/.../game.gba
# or
#   kind=app
#   target=<package-id>
#
# RetroArch saves the configured auto state during its normal termination
# (savestate_auto_save=true). rcK delivers SIGTERM before its final sync.
# Avoid enabling the unauthenticated UDP network-command listener just to force
# an extra save; this helper records the launch target and lets shutdown exit
# cleanly. The configured savestate_auto_load=true restores it on next launch.
set -u

STATE_DIR=/storage/.config/pocketjs
RESUME=$STATE_DIR/resume.state
LAST_ACTIVE=$STATE_DIR/last-active
mkdir -p "$STATE_DIR" 2>/dev/null || exit 0

log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S' 2>/dev/null || echo now)" "$*" >>/tmp/baseos-save-state.log 2>/dev/null || :; }

if pidof retroarch >/dev/null 2>&1; then
    rom=
    if [ -r /tmp/pocketjs-current-rom ]; then
        rom=$(head -n 1 /tmp/pocketjs-current-rom 2>/dev/null | tr -d '\r')
    elif [ -r "$LAST_ACTIVE" ]; then
        kind=$(sed -n 's/^kind=//p' "$LAST_ACTIVE" | head -1)
        target=$(sed -n 's/^target=//p' "$LAST_ACTIVE" | head -1)
        [ "$kind" = "rom" ] && rom=$target
    fi
    if [ -n "$rom" ]; then
        printf 'kind=rom\ntarget=%s\nsaved=%s\n' "$rom" "$(date +%s 2>/dev/null || echo 0)" > "$RESUME" 2>/dev/null || :
        log "saved ROM resume target: $rom"
    fi
    sync
    exit 0
fi

# last-active survives normal exits: it is not evidence of an active app.
# launch_frontend owns this volatile identity only during the child lifecycle.
app=
if pidof pocket-linux-kms >/dev/null 2>&1 && [ -r /run/baseos-foreground-app ]; then
    app=$(head -n 1 /run/baseos-foreground-app 2>/dev/null | tr -d '\r')
fi
case "$app" in
    ''|*[!a-zA-Z0-9._-]*) app= ;;
esac
[ "${#app}" -le 64 ] || app=
if [ -n "$app" ]; then
    if printf 'kind=app\ntarget=%s\n' "$app" > "$RESUME.new" 2>/dev/null; then
        mv "$RESUME.new" "$RESUME" 2>/dev/null || :
        log "saved foreground app for resume: $app"
    fi
else
    rm -f "$RESUME" "$RESUME.new" 2>/dev/null || :
    log "no foreground app; cleared stale resume target"
fi
sync
exit 0
