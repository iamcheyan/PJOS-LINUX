{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pjos.local/schema/soc-1.json",
  "title": "PJOS SoC Profile",
  "description": "Facts shared by every board on one SoC. See docs/bsp-v2/02-bsp-boundary.md §4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "soc", "arch", "kernel", "nodes", "hw_init"],
  "properties": {
    "schema": { "const": "pjos.soc/1" },
    "soc": {
      "type": "string",
      "pattern": "^[a-z0-9]+/[a-z0-9]+$",
      "description": "vendor/soc; must match the directory path bsp/<vendor>/<soc>/."
    },
    "compatible": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "arch": { "enum": ["aarch64", "armv7", "x86_64"] },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules"],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release", "abi_guard"],
          "properties": {
            "release": { "type": "string" },
            "abi_guard": {
              "type": "array",
              "items": { "enum": ["release", "version", "banner"] },
              "minItems": 1
            }
          }
        },
        "profiles": { "type": "string", "description": "Path within the SoC dir." },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source"],
            "properties": {
              "name": { "type": "string" },
              "source": { "enum": ["vendor", "bsp"] },
              "build": { "type": "string" },
              "flat": { "type": "string", "pattern": "^/usr/lib/modules/" }
            }
          }
        }
      }
    },
    "dtb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["stock", "bsp"] },
        "from": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "harvest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["list"],
      "properties": {
        "list": { "type": "string" },
        "base": { "enum": ["stock", "stockmod"] }
      }
    },
    "nodes": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "display": {"type": "object", "additionalProperties": false, "properties": {"fb": {"type": "array", "items": {"type": "string", "minLength": 1}}, "disp": {"type": "array", "items": {"type": "string", "minLength": 1}}, "brightness_node": {"type": "string", "minLength": 1}, "debugfs_switch": {"type": "string", "minLength": 1}}},
        "input": {"type": "object", "additionalProperties": false, "properties": {"glob": {"type": "string", "minLength": 1}, "gamepad_name": {"type": "string", "minLength": 1}}},
        "power": {"type": "object", "additionalProperties": false, "properties": {"poweroff": {"type": "string", "minLength": 1}, "reboot": {"type": "string", "minLength": 1}, "suspend_node": {"type": "string", "minLength": 1}, "supply_glob": {"type": "string", "minLength": 1}, "rtc": {"type": "string", "minLength": 1}, "long_press": {"enum": ["ignore", "poweroff", "unknown"]}}},
        "audio": {"type": "object", "additionalProperties": false, "properties": {"card_prefix": {"type": "string", "minLength": 1}, "lineout_control": {"type": "string", "minLength": 1}, "speaker_control": {"type": "string", "minLength": 1}, "volume_control": {"type": "string", "minLength": 1}}},
        "network": {"type": "object", "additionalProperties": false, "properties": {"wifi_iface": {"type": "string", "minLength": 1}, "interfaces": {"type": "array", "items": {"type": "string", "minLength": 1}}, "wifi_ctrl": {"type": "string", "minLength": 1}, "bt_uart": {"type": "string", "minLength": 1}, "bt_backend": {"type": "string", "minLength": 1}, "bt_hook": {"type": "string", "minLength": 1}, "mdns_hook": {"type": "string", "minLength": 1}}},
        "storage": {"type": "object", "additionalProperties": false, "properties": {"boot_disk": {"type": "string", "minLength": 1}, "roles": {"type": "object", "additionalProperties": false, "properties": {"boot": {"type": "integer", "minimum": 1}, "rootfs": {"type": "integer", "minimum": 1}, "data": {"type": "integer", "minimum": 1}, "primary": {"type": "integer", "minimum": 1}}}, "layout": {"type": "string", "minLength": 1}, "expand_hook": {"type": "string", "minLength": 1}, "card-mount_hook": {"type": "string", "minLength": 1}}},
        "led": {"type": "object", "additionalProperties": false, "properties": {"glob": {"type": "array", "items": {"type": "string", "minLength": 1}}, "work_node": {"type": "string", "minLength": 1}, "vibration_node": {"type": "string", "minLength": 1}}}
      }
    },
    "hw_init": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "when"],
        "properties": {
          "step": { "type": "string" },
          "module": { "type": "string" },
          "when": { "enum": ["boot", "before-frontend", "charger", "suspend"] },
          "background": { "type": "boolean" },
          "pre": { "type": "string" },
          "retry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "unload": { "type": "boolean" },
              "hold_ms": { "type": "integer", "minimum": 0 },
              "attempts": { "type": "integer", "minimum": 1 }
            }
          },
          "params": {"type": "object", "additionalProperties": false, "properties": {"apply": {"enum": [0, 1]}, "headphone_pop_fix": {"enum": [0, 1, "from-board"]}}}
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "enum": ["yes", "no", "unknown"] }
    },
    "features": {
      "type": "object",
      "additionalProperties": { "enum": ["yes", "no", "unknown"] }
    }
  }
}
